<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>net.kurobako.cef4j</groupId>
        <artifactId>cef4j-parent</artifactId>
        <version>146.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>cef4j-api</artifactId>
    <packaging>jar</packaging>
    <name>cef4j-api</name>
    <description>Java 8+ API for CEF OSR bindings</description>

    <dependencies>
        <dependency>
            <groupId>com.google.code.findbugs</groupId>
            <artifactId>jsr305</artifactId>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-simple</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-core</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>net.kurobako.cef4j</groupId>
            <artifactId>cef4j-platform</artifactId>
            <version>${project.version}</version>
            <classifier>${cef.platform}</classifier>
            <optional>true</optional>
        </dependency>
        <!-- Build-order edge: cef4j-native generates platform-specific Java types into this module's
             source tree. Keep this dependency so parallel reactor builds do not race API testCompile. -->
        <dependency>
            <groupId>net.kurobako.cef4j</groupId>
            <artifactId>cef4j-native</artifactId>
            <version>${project.version}</version>
            <type>pom</type>
            <scope>test</scope>
            <optional>true</optional>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>com.diffplug.spotless</groupId>
                <artifactId>spotless-maven-plugin</artifactId>
                <configuration>
                    <java>
                        <excludes>
                            <exclude>src/main/java/net/kurobako/cef4j/gen/**/*.java</exclude>
                        </excludes>
                    </java>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <systemPropertyVariables>
                        <cef4j.libcef.dir>${cef.dist.dir}/Release</cef4j.libcef.dir>
                    </systemPropertyVariables>
                    <!-- Tests in this list need their own JVM because they initialise CEF with
                         incompatible settings (app handlers, scheme factories, multiThreadedMessageLoop)
                         and CEF cannot be re-initialised once started. The default fork shares CEF
                         across compatible tests; the isolated execution below gives each of these a
                         fresh JVM via reuseForks=false + forkCount=1. -->
                    <excludes>
                        <exclude>**/CefScriptEngineMultiThreadedTest.java</exclude>
                        <exclude>**/CefSchemeHandlerTest.java</exclude>
                        <exclude>**/CefDaemonRenderTest.java</exclude>
                        <exclude>**/CefAppDelegatingTest.java</exclude>
                    </excludes>
                </configuration>
                <executions>
                    <execution>
                        <id>isolated-cef-tests</id>
                        <goals><goal>test</goal></goals>
                        <configuration>
                            <reuseForks>false</reuseForks>
                            <forkCount>1</forkCount>
                            <excludes combine.self="override"/>
                            <includes>
                                <include>**/CefSchemeHandlerTest.java</include>
                                <include>**/CefDaemonRenderTest.java</include>
                                <include>**/CefScriptEngineMultiThreadedTest.java</include>
                                <include>**/CefAppDelegatingTest.java</include>
                            </includes>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-javadoc-plugin</artifactId>
                <executions>
                    <execution>
                        <id>verify-javadocs</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>jar</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
