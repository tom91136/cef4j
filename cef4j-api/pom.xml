<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>net.kurobako.cef4j</groupId>
        <artifactId>cef4j-parent</artifactId>
        <version>150.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>cef4j-api</artifactId>
    <name>cef4j-api</name>
    <description>Java 11+ API for CEF OSR bindings</description>

    <properties>
        <exec.skip>false</exec.skip>
    </properties>

    <dependencies>
        <dependency>
            <groupId>com.google.code.findbugs</groupId>
            <artifactId>jsr305</artifactId>
        </dependency>
        <dependency>
            <groupId>net.kurobako.cef4j</groupId>
            <artifactId>cef4j-code-policy</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>net.kurobako.cef4j</groupId>
            <artifactId>cef4j-cef-dist</artifactId>
            <type>pom</type>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-simple</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-core</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>net.kurobako.cef4j</groupId>
            <artifactId>cef4j-test-support</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>net.kurobako.cef4j</groupId>
            <artifactId>cef4j-platform</artifactId>
            <classifier>${cef.classifier}</classifier>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <resources>
            <resource>
                <directory>src/main/resources</directory>
                <filtering>true</filtering>
            </resource>
        </resources>
        <plugins>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>generate-cef-api</id>
                        <phase>generate-sources</phase>
                        <goals><goal>java</goal></goals>
                        <configuration>
                            <includePluginDependencies>true</includePluginDependencies>
                            <mainClass>net.kurobako.cef4j.codegen.Main</mainClass>
                            <arguments>
                                <argument>--cef-include=${cef.codegen.linux.dir}/include</argument>
                                <argument>--out-cpp=${project.build.directory}/discarded-codegen-cpp</argument>
                                <argument>--out-java=${project.basedir}/src/main/java</argument>
                                <argument>--java-package=${cef4j.generated.java.package}</argument>
                                <argument>--compiler=${native.compiler.id}</argument>
                                <argument>--cef-api-version=${cef.version}</argument>
                                <argument>--target-platform=${cef.codegen.linux.platform}</argument>
                                <argument>--emit-common-cpp=false</argument>
                                <argument>--regenerate-command=./mvnw generate-sources -pl cef4j-api -Dcef.version=${cef.version}</argument>
                                <argument>--extra-cpp-dirs=views</argument>
                                <argument>--extra-capi-dirs=views</argument>
                            </arguments>
                        </configuration>
                    </execution>
                    <execution>
                        <id>generate-cef-api-macos-platform</id>
                        <phase>generate-sources</phase>
                        <goals><goal>java</goal></goals>
                        <configuration>
                            <includePluginDependencies>true</includePluginDependencies>
                            <mainClass>net.kurobako.cef4j.codegen.Main</mainClass>
                            <arguments>
                                <argument>--cef-include=${cef.codegen.macos.dir}/include</argument>
                                <argument>--out-cpp=${project.build.directory}/discarded-codegen-cpp</argument>
                                <argument>--out-java=${project.basedir}/src/main/java</argument>
                                <argument>--java-package=${cef4j.generated.java.package}</argument>
                                <argument>--compiler=${native.compiler.id}</argument>
                                <argument>--cef-api-version=${cef.version}</argument>
                                <argument>--target-platform=${cef.codegen.macos.platform}</argument>
                                <argument>--emit-common-cpp=false</argument>
                                <argument>--emit-java-platform-only=true</argument>
                                <argument>--java-platform-subpackage=mac</argument>
                                <argument>--regenerate-command=./mvnw generate-sources -pl cef4j-api -Dcef.version=${cef.version}</argument>
                                <argument>--extra-cpp-dirs=views</argument>
                                <argument>--extra-capi-dirs=views</argument>
                            </arguments>
                        </configuration>
                    </execution>
                    <execution>
                        <id>generate-cef-api-windows-platform</id>
                        <phase>generate-sources</phase>
                        <goals><goal>java</goal></goals>
                        <configuration>
                            <includePluginDependencies>true</includePluginDependencies>
                            <mainClass>net.kurobako.cef4j.codegen.Main</mainClass>
                            <arguments>
                                <argument>--cef-include=${cef.codegen.windows.dir}/include</argument>
                                <argument>--out-cpp=${project.build.directory}/discarded-codegen-cpp</argument>
                                <argument>--out-java=${project.basedir}/src/main/java</argument>
                                <argument>--java-package=${cef4j.generated.java.package}</argument>
                                <argument>--compiler=${native.compiler.id}</argument>
                                <argument>--cef-api-version=${cef.version}</argument>
                                <argument>--target-platform=${cef.codegen.windows.platform}</argument>
                                <argument>--emit-common-cpp=false</argument>
                                <argument>--emit-java-platform-only=true</argument>
                                <argument>--java-platform-subpackage=win</argument>
                                <argument>--regenerate-command=./mvnw generate-sources -pl cef4j-api -Dcef.version=${cef.version}</argument>
                                <argument>--extra-cpp-dirs=views</argument>
                                <argument>--extra-capi-dirs=views</argument>
                            </arguments>
                        </configuration>
                    </execution>
                    <execution>
                        <id>generate-cef-api-linux-platform</id>
                        <phase>generate-sources</phase>
                        <goals><goal>java</goal></goals>
                        <configuration>
                            <includePluginDependencies>true</includePluginDependencies>
                            <mainClass>net.kurobako.cef4j.codegen.Main</mainClass>
                            <arguments>
                                <argument>--cef-include=${cef.codegen.linux.dir}/include</argument>
                                <argument>--out-cpp=${project.build.directory}/discarded-codegen-cpp</argument>
                                <argument>--out-java=${project.basedir}/src/main/java</argument>
                                <argument>--java-package=${cef4j.generated.java.package}</argument>
                                <argument>--compiler=${native.compiler.id}</argument>
                                <argument>--cef-api-version=${cef.version}</argument>
                                <argument>--target-platform=${cef.codegen.linux.platform}</argument>
                                <argument>--emit-common-cpp=false</argument>
                                <argument>--emit-java-platform-only=true</argument>
                                <argument>--java-platform-subpackage=linux</argument>
                                <argument>--regenerate-command=./mvnw generate-sources -pl cef4j-api -Dcef.version=${cef.version}</argument>
                                <argument>--extra-cpp-dirs=views</argument>
                                <argument>--extra-capi-dirs=views</argument>
                            </arguments>
                        </configuration>
                    </execution>
                </executions>
                <dependencies>
                    <dependency>
                        <groupId>net.kurobako.cef4j</groupId>
                        <artifactId>cef4j-codegen</artifactId>
                        <version>${project.version}</version>
                    </dependency>
                </dependencies>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-antrun-plugin</artifactId>
                <executions>
                    <execution>
                        <id>bucket-v144-plus-tests</id>
                        <phase>initialize</phase>
                        <goals>
                            <goal>run</goal>
                        </goals>
                        <configuration>
                            <exportAntProperties>true</exportAntProperties>
                            <target>
                                <!-- Match cef.version so a -Dcef.version override needs no matching cef.api.version. -->
                                <condition property="cef4j.test.v144plus.excludes"
                                           value="__never__"
                                           else="**/CefV144Plus*.java">
                                    <matches string="${cef.version}"
                                             pattern="^(14[4-9]|1[5-9][0-9]|[2-9][0-9]{2,})\..*"/>
                                </condition>
                            </target>
                        </configuration>
                    </execution>
                    <execution>
                        <id>verify-packaged-cef-api-version</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>run</goal>
                        </goals>
                        <configuration>
                            <target>
                                <loadresource property="packaged.cef.api.version">
                                    <zipentry zipfile="${project.build.directory}/${project.build.finalName}.jar"
                                              name="META-INF/cef4j/cef-api-version"/>
                                    <filterchain>
                                        <striplinebreaks/>
                                    </filterchain>
                                </loadresource>
                                <condition property="packaged.cef.api.version.matches">
                                    <equals arg1="${packaged.cef.api.version}" arg2="${cef.api.version}"/>
                                </condition>
                                <fail unless="packaged.cef.api.version.matches"
                                      message="Packaged CEF API version metadata is missing or stale"/>
                            </target>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <testExcludes>
                        <testExclude>${cef4j.test.v144plus.excludes}</testExclude>
                    </testExcludes>
                    <testIncrementalExcludes>
                        <testIncrementalExclude>${cef4j.test.v144plus.excludes}</testIncrementalExclude>
                    </testIncrementalExcludes>
                </configuration>
            </plugin>
            <plugin>
                <groupId>com.diffplug.spotless</groupId>
                <artifactId>spotless-maven-plugin</artifactId>
                <configuration>
                    <java>
                        <excludes>
                            <exclude>src/main/java/net/kurobako/cef4j/gen/**/*.java</exclude>
                        </excludes>
                    </java>
                </configuration>
                <executions>
                    <execution>
                        <id>format-generated-cef-api</id>
                        <phase>generate-sources</phase>
                        <goals><goal>apply</goal></goals>
                        <configuration>
                            <java>
                                <includes>
                                    <include>src/main/java/net/kurobako/cef4j/gen/**/*.java</include>
                                </includes>
                                <excludes combine.self="override"/>
                            </java>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <argLine>@{jacoco.argLine} ${surefire.argLine} -javaagent:${settings.localRepository}/org/mockito/mockito-core/${mockito.version}/mockito-core-${mockito.version}.jar</argLine>
                    <!-- Fresh JVM per class: native CEF state does not survive across test classes. -->
                    <reuseForks>false</reuseForks>
                    <forkCount>1</forkCount>
                    <!-- These classes initialise CEF with incompatible settings and cannot share a process. -->
                    <excludes>
                        <exclude>**/CefScriptEngineMultiThreadedTest.java</exclude>
                        <exclude>**/CefSchemeHandlerTest.java</exclude>
                        <exclude>**/CefDaemonRenderTest.java</exclude>
                        <exclude>**/CefAppDelegatingTest.java</exclude>
                        <exclude>**/CefV144PlusViewsInteropTest.java</exclude>
                        <!-- CefXml/ZipReader cross-contaminate on older CEF (<144) on macOS. -->
                        <exclude>**/CefXmlReaderTest.java</exclude>
                        <exclude>**/CefZipReaderTest.java</exclude>
                        <exclude>${cef4j.test.v144plus.excludes}</exclude>
                    </excludes>
                </configuration>
                <executions>
                    <execution>
                        <id>isolated-cef-tests</id>
                        <goals><goal>test</goal></goals>
                        <configuration>
                            <reuseForks>false</reuseForks>
                            <forkCount>1</forkCount>
                            <excludes combine.self="override">
                                <exclude>${cef4j.test.v144plus.excludes}</exclude>
                            </excludes>
                            <includes>
                                <include>**/CefSchemeHandlerTest.java</include>
                                <include>**/CefDaemonRenderTest.java</include>
                                <include>**/CefScriptEngineMultiThreadedTest.java</include>
                                <include>**/CefAppDelegatingTest.java</include>
                                <include>**/CefV144PlusViewsInteropTest.java</include>
                                <include>**/CefXmlReaderTest.java</include>
                                <include>**/CefZipReaderTest.java</include>
                            </includes>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-javadoc-plugin</artifactId>
                <executions>
                    <execution>
                        <id>verify-javadocs</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>jar</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <configuration>
                    <!-- Native files are staged in target/classes only for reactor tests. Published
                         native payloads belong exclusively to classified cef4j-platform JARs. -->
                    <excludes>
                        <exclude>native/**</exclude>
                        <exclude>cef-runtime/**</exclude>
                    </excludes>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>
