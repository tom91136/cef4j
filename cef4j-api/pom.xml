<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>net.kurobako.cef4j</groupId>
        <artifactId>cef4j-parent</artifactId>
        <version>150.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>cef4j-api</artifactId>
    <packaging>jar</packaging>
    <name>cef4j-api</name>
    <description>Java 11+ API for CEF OSR bindings</description>

    <dependencies>
        <dependency>
            <groupId>com.google.code.findbugs</groupId>
            <artifactId>jsr305</artifactId>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-simple</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-core</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>net.kurobako.cef4j</groupId>
            <artifactId>cef4j-test-shared</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>net.kurobako.cef4j</groupId>
            <artifactId>cef4j-platform</artifactId>
            <version>${project.version}</version>
            <classifier>${cef.classifier}</classifier>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-antrun-plugin</artifactId>
                <executions>
                    <execution>
                        <id>bucket-v144-plus-tests</id>
                        <phase>initialize</phase>
                        <goals>
                            <goal>run</goal>
                        </goals>
                        <configuration>
                            <exportAntProperties>true</exportAntProperties>
                            <target>
                                <!-- Gate CefV144Plus* tests on the CEF major version.
                                     Match against cef.version (the full version string, e.g.
                                     "150.0.18+g...") so that -Dcef.version=116... overrides
                                     work without also requiring -Dcef.api.version=116. -->
                                <condition property="cef4j.test.v144plus.excludes"
                                           value="__never__"
                                           else="**/CefV144Plus*.java">
                                    <matches string="${cef.version}"
                                             pattern="^(14[4-9]|1[5-9][0-9]|[2-9][0-9]{2,})\..*"/>
                                </condition>
                            </target>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <testExcludes>
                        <testExclude>${cef4j.test.v144plus.excludes}</testExclude>
                    </testExcludes>
                    <testIncrementalExcludes>
                        <testIncrementalExclude>${cef4j.test.v144plus.excludes}</testIncrementalExclude>
                    </testIncrementalExcludes>
                </configuration>
            </plugin>
            <plugin>
                <groupId>com.diffplug.spotless</groupId>
                <artifactId>spotless-maven-plugin</artifactId>
                <configuration>
                    <java>
                        <excludes>
                            <exclude>src/main/java/net/kurobako/cef4j/gen/**/*.java</exclude>
                        </excludes>
                    </java>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <!-- Native CEF is process-global and older releases retain state that can corrupt
                         the next test class (most visibly on macOS). Every class still runs; giving each
                         one a fresh process makes the lifecycle boundary match an end-user application. -->
                    <reuseForks>false</reuseForks>
                    <forkCount>1</forkCount>
                    <!-- Tests in this list need a separate execution because they initialise CEF with
                         incompatible settings (app handlers, scheme factories, multiThreadedMessageLoop)
                         and CEF cannot be re-initialised once started. The isolated execution below
                         selects those classes while reuseForks=false gives every selected class a fresh JVM. -->
                    <excludes>
                        <exclude>**/CefScriptEngineMultiThreadedTest.java</exclude>
                        <exclude>**/CefSchemeHandlerTest.java</exclude>
                        <exclude>**/CefDaemonRenderTest.java</exclude>
                        <exclude>**/CefAppDelegatingTest.java</exclude>
                        <exclude>**/CefV144PlusViewsInteropTest.java</exclude>
                        <!-- CefXml/ZipReader cross-contaminate with browser-using tests on
                             older CEF (<144) on macOS — run them in isolated forks below. -->
                        <exclude>**/CefXmlReaderTest.java</exclude>
                        <exclude>**/CefZipReaderTest.java</exclude>
                        <!-- Exclude V144+ tests when building against older CEF -->
                        <exclude>${cef4j.test.v144plus.excludes}</exclude>
                    </excludes>
                </configuration>
                <executions>
                    <execution>
                        <id>isolated-cef-tests</id>
                        <goals><goal>test</goal></goals>
                        <configuration>
                            <reuseForks>false</reuseForks>
                            <forkCount>1</forkCount>
                            <excludes combine.self="override">
                                <exclude>${cef4j.test.v144plus.excludes}</exclude>
                            </excludes>
                            <includes>
                                <include>**/CefSchemeHandlerTest.java</include>
                                <include>**/CefDaemonRenderTest.java</include>
                                <include>**/CefScriptEngineMultiThreadedTest.java</include>
                                <include>**/CefAppDelegatingTest.java</include>
                                <include>**/CefV144PlusViewsInteropTest.java</include>
                                <include>**/CefXmlReaderTest.java</include>
                                <include>**/CefZipReaderTest.java</include>
                            </includes>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-javadoc-plugin</artifactId>
                <executions>
                    <execution>
                        <id>verify-javadocs</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>jar</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <configuration>
                    <!-- Native files are staged in target/classes only for reactor tests. Published
                         native payloads belong exclusively to classified cef4j-platform JARs. -->
                    <excludes>
                        <exclude>native/**</exclude>
                        <exclude>cef-runtime/**</exclude>
                    </excludes>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>
