<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>net.kurobako.cef4j</groupId>
        <artifactId>cef4j-parent</artifactId>
        <version>146.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>cef4j-native</artifactId>
    <packaging>pom</packaging>
    <name>cef4j-native</name>
    <description>C++ JNI layer for CEF bindings</description>

    <properties>
        <exec.skip>false</exec.skip>
        <cef.codegen.linux.platform>linux64</cef.codegen.linux.platform>
        <cef.codegen.macos.platform>macosx64</cef.codegen.macos.platform>
        <cef.codegen.windows.platform>windows64</cef.codegen.windows.platform>
        <cef.codegen.linux.url>https://cef-builds.spotifycdn.com/cef_binary_${cef.version}_${cef.codegen.linux.platform}_minimal.tar.bz2</cef.codegen.linux.url>
        <cef.codegen.macos.url>https://cef-builds.spotifycdn.com/cef_binary_${cef.version}_${cef.codegen.macos.platform}_minimal.tar.bz2</cef.codegen.macos.url>
        <cef.codegen.windows.url>https://cef-builds.spotifycdn.com/cef_binary_${cef.version}_${cef.codegen.windows.platform}_minimal.tar.bz2</cef.codegen.windows.url>
        <cef.codegen.linux.dir>${cef.dist.cache}/cef_binary_${cef.version}_${cef.codegen.linux.platform}_minimal</cef.codegen.linux.dir>
        <cef.codegen.macos.dir>${cef.dist.cache}/cef_binary_${cef.version}_${cef.codegen.macos.platform}_minimal</cef.codegen.macos.dir>
        <cef.codegen.windows.dir>${cef.dist.cache}/cef_binary_${cef.version}_${cef.codegen.windows.platform}_minimal</cef.codegen.windows.dir>
    </properties>

    <build>
        <plugins>
            <!-- Step 1: Download + extract CEF binary distribution (cached in .cef-dist/).
                 unpackWhenChanged=true extracts only on first download or when the tarball changes;
                 this replaces the prior ant <untar>/<condition> guard dance. -->
            <plugin>
                <groupId>com.googlecode.maven-download-plugin</groupId>
                <artifactId>download-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>download-cef</id>
                        <phase>initialize</phase>
                        <goals>
                            <goal>wget</goal>
                        </goals>
                        <configuration>
                            <url>${cef.dist.url}</url>
                            <outputDirectory>${cef.dist.cache}</outputDirectory>
                            <unpackWhenChanged>true</unpackWhenChanged>
                            <skipCache>false</skipCache>
                        </configuration>
                    </execution>
                    <execution>
                        <id>download-cef-linux-codegen</id>
                        <phase>initialize</phase>
                        <goals>
                            <goal>wget</goal>
                        </goals>
                        <configuration>
                            <url>${cef.codegen.linux.url}</url>
                            <outputDirectory>${cef.dist.cache}</outputDirectory>
                            <unpackWhenChanged>true</unpackWhenChanged>
                            <skipCache>false</skipCache>
                        </configuration>
                    </execution>
                    <execution>
                        <id>download-cef-macos-codegen</id>
                        <phase>initialize</phase>
                        <goals>
                            <goal>wget</goal>
                        </goals>
                        <configuration>
                            <url>${cef.codegen.macos.url}</url>
                            <outputDirectory>${cef.dist.cache}</outputDirectory>
                            <unpackWhenChanged>true</unpackWhenChanged>
                            <skipCache>false</skipCache>
                        </configuration>
                    </execution>
                    <execution>
                        <id>download-cef-windows-codegen</id>
                        <phase>initialize</phase>
                        <goals>
                            <goal>wget</goal>
                        </goals>
                        <configuration>
                            <url>${cef.codegen.windows.url}</url>
                            <outputDirectory>${cef.dist.cache}</outputDirectory>
                            <unpackWhenChanged>true</unpackWhenChanged>
                            <skipCache>false</skipCache>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-antrun-plugin</artifactId>
                <executions>
                    <execution>
                        <id>mkdir-cmake-build</id>
                        <phase>initialize</phase>
                        <goals>
                            <goal>run</goal>
                        </goals>
                        <configuration>
                            <target>
                                <mkdir dir="${project.build.directory}/cmake-build"/>
                            </target>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!-- Step 2: Invoke codegen -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>run-codegen</id>
                        <phase>generate-sources</phase>
                        <goals>
                            <goal>java</goal>
                        </goals>
                        <configuration>
                            <includePluginDependencies>true</includePluginDependencies>
                            <mainClass>net.kurobako.cef4j.codegen.Main</mainClass>
                            <arguments>
                                <argument>--cef-include=${cef.codegen.linux.dir}/include</argument>
                                <argument>--out-cpp=${project.basedir}/native/gen</argument>
                                <argument>--out-java=${project.basedir}/../cef4j-api/src/main/java</argument>
                                <argument>--java-package=${cef4j.generated.java.package}</argument>
                                <argument>--compiler=${native.compiler.id}</argument>
                                <argument>--cef-api-version=${cef.version}</argument>
                                <argument>--target-platform=${cef.codegen.linux.platform}</argument>
                                <argument>--extra-cpp-dirs=views</argument>
                                <argument>--extra-capi-dirs=views</argument>
                            </arguments>
                        </configuration>
                    </execution>
                    <execution>
                        <id>run-codegen-macos-platform</id>
                        <phase>generate-sources</phase>
                        <goals>
                            <goal>java</goal>
                        </goals>
                        <configuration>
                            <includePluginDependencies>true</includePluginDependencies>
                            <mainClass>net.kurobako.cef4j.codegen.Main</mainClass>
                            <arguments>
                                <argument>--cef-include=${cef.codegen.macos.dir}/include</argument>
                                <argument>--out-cpp=${project.basedir}/native/gen</argument>
                                <argument>--out-java=${project.basedir}/../cef4j-api/src/main/java</argument>
                                <argument>--java-package=${cef4j.generated.java.package}</argument>
                                <argument>--compiler=${native.compiler.id}</argument>
                                <argument>--cef-api-version=${cef.version}</argument>
                                <argument>--target-platform=${cef.codegen.macos.platform}</argument>
                                <argument>--emit-common-cpp=false</argument>
                                <argument>--emit-java-platform-only=true</argument>
                                <argument>--java-platform-subpackage=mac</argument>
                                <argument>--extra-cpp-dirs=views</argument>
                                <argument>--extra-capi-dirs=views</argument>
                            </arguments>
                        </configuration>
                    </execution>
                    <execution>
                        <id>run-codegen-windows-platform</id>
                        <phase>generate-sources</phase>
                        <goals>
                            <goal>java</goal>
                        </goals>
                        <configuration>
                            <includePluginDependencies>true</includePluginDependencies>
                            <mainClass>net.kurobako.cef4j.codegen.Main</mainClass>
                            <arguments>
                                <argument>--cef-include=${cef.codegen.windows.dir}/include</argument>
                                <argument>--out-cpp=${project.basedir}/native/gen</argument>
                                <argument>--out-java=${project.basedir}/../cef4j-api/src/main/java</argument>
                                <argument>--java-package=${cef4j.generated.java.package}</argument>
                                <argument>--compiler=${native.compiler.id}</argument>
                                <argument>--cef-api-version=${cef.version}</argument>
                                <argument>--target-platform=${cef.codegen.windows.platform}</argument>
                                <argument>--emit-common-cpp=false</argument>
                                <argument>--emit-java-platform-only=true</argument>
                                <argument>--java-platform-subpackage=win</argument>
                                <argument>--extra-cpp-dirs=views</argument>
                                <argument>--extra-capi-dirs=views</argument>
                            </arguments>
                        </configuration>
                    </execution>
                    <execution>
                        <id>run-codegen-linux-platform-java</id>
                        <phase>generate-sources</phase>
                        <goals>
                            <goal>java</goal>
                        </goals>
                        <configuration>
                            <includePluginDependencies>true</includePluginDependencies>
                            <mainClass>net.kurobako.cef4j.codegen.Main</mainClass>
                            <arguments>
                                <argument>--cef-include=${cef.codegen.linux.dir}/include</argument>
                                <argument>--out-cpp=${project.basedir}/native/gen</argument>
                                <argument>--out-java=${project.basedir}/../cef4j-api/src/main/java</argument>
                                <argument>--java-package=${cef4j.generated.java.package}</argument>
                                <argument>--compiler=${native.compiler.id}</argument>
                                <argument>--cef-api-version=${cef.version}</argument>
                                <argument>--target-platform=${cef.codegen.linux.platform}</argument>
                                <argument>--emit-common-cpp=false</argument>
                                <argument>--emit-java-platform-only=true</argument>
                                <argument>--java-platform-subpackage=linux</argument>
                                <argument>--extra-cpp-dirs=views</argument>
                                <argument>--extra-capi-dirs=views</argument>
                            </arguments>
                        </configuration>
                    </execution>
                    <execution>
                        <id>cmake-configure</id>
                        <phase>compile</phase>
                        <goals>
                            <goal>exec</goal>
                        </goals>
                        <configuration>
                            <executable>cmake</executable>
                            <workingDirectory>${project.build.directory}/cmake-build</workingDirectory>
                            <arguments>
                                <argument>${project.basedir}</argument>
                                <argument>-G${cmake.generator}</argument>
                                <argument>-DCMAKE_TOOLCHAIN_FILE=${cmake.toolchain.file}</argument>
                                <argument>-DCEF_ROOT=${cef.dist.dir}</argument>
                                <argument>-DJAVA_HOME=${java.home}</argument>
                                <argument>-DCEF4J_API_VERSION_RAW=${cef.version}</argument>
                                <argument>-DCMAKE_BUILD_TYPE=Release</argument>
                                <argument>-DCMAKE_CXX_STANDARD=17</argument>
                                <argument>-DCMAKE_CXX_STANDARD_REQUIRED=ON</argument>
                                <argument>-DCEF4J_STATIC_RUNTIME=ON</argument>
                            </arguments>
                        </configuration>
                    </execution>
                    <execution>
                        <id>cmake-build</id>
                        <phase>compile</phase>
                        <goals>
                            <goal>exec</goal>
                        </goals>
                        <configuration>
                            <executable>cmake</executable>
                            <arguments>
                                <argument>--build</argument>
                                <argument>${project.build.directory}/cmake-build</argument>
                                <argument>--config</argument>
                                <argument>Release</argument>
                                <argument>--parallel</argument>
                            </arguments>
                        </configuration>
                    </execution>
                </executions>
                <dependencies>
                    <dependency>
                        <groupId>net.kurobako.cef4j</groupId>
                        <artifactId>cef4j-codegen</artifactId>
                        <version>${project.version}</version>
                    </dependency>
                </dependencies>
            </plugin>

            <!-- Step 4: Stage JNI + launcher for the classified platform artifact. Keeping
                 these out of cef4j-api makes that Maven coordinate platform-neutral. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-resources-plugin</artifactId>
                <executions>
                    <execution>
                        <id>copy-native-lib</id>
                        <phase>process-classes</phase>
                        <goals>
                            <goal>copy-resources</goal>
                        </goals>
                        <configuration>
                            <outputDirectory>${maven.multiModuleProjectDirectory}/target/platform-native/native/${cef.platform}</outputDirectory>
                            <resources>
                                <resource>
                                    <directory>${project.build.directory}/cmake-build</directory>
                                    <includes>
                                        <include>libcef4j.so</include>
                                        <include>cef4j.dll</include>
                                        <include>libcef4j.dylib</include>
                                        <include>cef4j_launcher</include>
                                        <include>cef4j_launcher.exe</include>
                                    </includes>
                                </resource>
                            </resources>
                        </configuration>
                    </execution>
                    <execution>
                        <id>copy-native-lib-for-reactor-tests</id>
                        <phase>process-classes</phase>
                        <goals>
                            <goal>copy-resources</goal>
                        </goals>
                        <configuration>
                            <!-- The classified platform JAR is attached at package, after the test phase.
                                 Stage the same files in API output so reactor tests can start CEF; cef4j-api's
                                 JAR excludes this directory and therefore remains platform-neutral. -->
                            <outputDirectory>${project.basedir}/../cef4j-api/target/classes/native/${cef.platform}</outputDirectory>
                            <resources>
                                <resource>
                                    <directory>${project.build.directory}/cmake-build</directory>
                                    <includes>
                                        <include>libcef4j.so</include>
                                        <include>cef4j.dll</include>
                                        <include>libcef4j.dylib</include>
                                        <include>cef4j_launcher</include>
                                        <include>cef4j_launcher.exe</include>
                                    </includes>
                                </resource>
                            </resources>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>com.diffplug.spotless</groupId>
                <artifactId>spotless-maven-plugin</artifactId>
                <configuration>
                    <java>
                        <includes>
                            <include>../cef4j-api/src/main/java/net/kurobako/cef4j/gen/**/*.java</include>
                        </includes>
                        <palantirJavaFormat>
                            <version>${palantir.java.format.version}</version>
                            <style>PALANTIR</style>
                            <formatJavadoc>true</formatJavadoc>
                        </palantirJavaFormat>
                    </java>
                    <cpp>
                        <includes>
                            <include>cef4j-native/native/gen/**/*.cpp</include>
                            <include>cef4j-native/native/gen/**/*.h</include>
                        </includes>
                        <eclipseCdt>
                            <version>11.6</version>
                            <file>${maven.multiModuleProjectDirectory}/eclipse-cdt-format.xml</file>
                        </eclipseCdt>
                    </cpp>
                </configuration>
                <executions>
                    <execution>
                        <id>format-generated-sources</id>
                        <phase>generate-sources</phase>
                        <goals>
                            <goal>apply</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

        </plugins>
    </build>

</project>
