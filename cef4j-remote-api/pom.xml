<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>net.kurobako.cef4j</groupId>
        <artifactId>cef4j-parent</artifactId>
        <version>146.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>cef4j-remote-api</artifactId>
    <packaging>jar</packaging>
    <name>cef4j-remote-api</name>
    <description>Generated Remote CEF API and transport-neutral Chrome DevTools client</description>

    <properties>
        <exec.skip>false</exec.skip>
        <ipc.gen.package>net.kurobako.cef4j.ipc.protocol.gen</ipc.gen.package>
        <ipc.gen.dir>${project.basedir}/src/main/java</ipc.gen.dir>
    </properties>

    <dependencies>
        <dependency>
            <groupId>net.kurobako.cef4j</groupId>
            <artifactId>cef4j-remote-core</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>net.kurobako.cef4j</groupId>
            <artifactId>cef4j-cdp</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.google.code.findbugs</groupId>
            <artifactId>jsr305</artifactId>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
        </dependency>

        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-simple</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>net.kurobako.cef4j</groupId>
            <artifactId>cef4j-remote-recording-jackson</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <resources>
            <resource>
                <directory>src/main/resources</directory>
                <filtering>true</filtering>
            </resource>
        </resources>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-resources-plugin</artifactId>
                <configuration>
                    <propertiesEncoding>UTF-8</propertiesEncoding>
                </configuration>
            </plugin>
            <!-- IPC codegen needs the CEF headers; share the same dist cache as cef4j-native. Runs at
                 `initialize` so the headers exist by the time exec-maven-plugin runs `Main` at `generate-sources`. -->
            <plugin>
                <groupId>com.googlecode.maven-download-plugin</groupId>
                <artifactId>download-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>download-cef-for-ipc-codegen</id>
                        <phase>initialize</phase>
                        <goals><goal>wget</goal></goals>
                        <configuration>
                            <url>${cef.dist.url}</url>
                            <outputDirectory>${cef.dist.cache}</outputDirectory>
                            <unpackWhenChanged>true</unpackWhenChanged>
                            <skipCache>false</skipCache>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>run-ipc-codegen</id>
                        <phase>generate-sources</phase>
                        <goals><goal>java</goal></goals>
                        <configuration>
                            <includePluginDependencies>true</includePluginDependencies>
                            <mainClass>net.kurobako.cef4j.codegen.ipc.Main</mainClass>
                            <arguments>
                                <argument>--out-java=${ipc.gen.dir}</argument>
                                <argument>--java-package=${ipc.gen.package}</argument>
                                <argument>--cef-include=${cef.dist.dir}/include</argument>
                                <argument>--compiler=${native.compiler.id}</argument>
                                <argument>--cef-api-version=${cef.version}</argument>
                            </arguments>
                        </configuration>
                    </execution>
                </executions>
                <dependencies>
                    <dependency>
                        <groupId>net.kurobako.cef4j</groupId>
                        <artifactId>cef4j-codegen</artifactId>
                        <version>${project.version}</version>
                    </dependency>
                </dependencies>
            </plugin>
            <plugin>
                <groupId>com.diffplug.spotless</groupId>
                <artifactId>spotless-maven-plugin</artifactId>
                <configuration>
                    <java>
                        <excludes>
                            <exclude>src/main/java/net/kurobako/cef4j/ipc/protocol/gen/**/*.java</exclude>
                        </excludes>
                    </java>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
