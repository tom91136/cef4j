<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>net.kurobako.cef4j</groupId>
        <artifactId>cef4j-parent</artifactId>
        <version>150.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>cef4j-platform</artifactId>
    <packaging>pom</packaging>
    <name>cef4j-platform</name>
    <description>Platform-specific cef4j JNI bridge and subprocess launcher</description>

    <properties>
        <exec.skip>false</exec.skip>
    </properties>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-antrun-plugin</artifactId>
                <executions>
                    <execution>
                        <id>mkdir-cmake-build</id>
                        <phase>initialize</phase>
                        <goals>
                            <goal>run</goal>
                        </goals>
                        <configuration>
                            <target>
                                <mkdir dir="${project.build.directory}/cmake-build"/>
                            </target>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!-- Step 2: Invoke codegen -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>run-codegen</id>
                        <phase>generate-sources</phase>
                        <goals>
                            <goal>java</goal>
                        </goals>
                        <configuration>
                            <includePluginDependencies>true</includePluginDependencies>
                            <mainClass>net.kurobako.cef4j.codegen.Main</mainClass>
                            <arguments>
                                <argument>--cef-include=${cef.codegen.linux.dir}/include</argument>
                                <argument>--out-cpp=${project.basedir}/native/gen</argument>
                                <argument>--out-java=${project.basedir}/../cef4j-api/src/main/java</argument>
                                <argument>--java-package=${cef4j.generated.java.package}</argument>
                                <argument>--compiler=${native.compiler.id}</argument>
                                <argument>--cef-api-version=${cef.version}</argument>
                                <argument>--target-platform=${cef.codegen.linux.platform}</argument>
                                <argument>--extra-cpp-dirs=views</argument>
                                <argument>--extra-capi-dirs=views</argument>
                            </arguments>
                        </configuration>
                    </execution>
                    <execution>
                        <id>run-codegen-macos-platform</id>
                        <phase>generate-sources</phase>
                        <goals>
                            <goal>java</goal>
                        </goals>
                        <configuration>
                            <includePluginDependencies>true</includePluginDependencies>
                            <mainClass>net.kurobako.cef4j.codegen.Main</mainClass>
                            <arguments>
                                <argument>--cef-include=${cef.codegen.macos.dir}/include</argument>
                                <argument>--out-cpp=${project.basedir}/native/gen</argument>
                                <argument>--out-java=${project.basedir}/../cef4j-api/src/main/java</argument>
                                <argument>--java-package=${cef4j.generated.java.package}</argument>
                                <argument>--compiler=${native.compiler.id}</argument>
                                <argument>--cef-api-version=${cef.version}</argument>
                                <argument>--target-platform=${cef.codegen.macos.platform}</argument>
                                <argument>--emit-common-cpp=false</argument>
                                <argument>--emit-java-platform-only=true</argument>
                                <argument>--java-platform-subpackage=mac</argument>
                                <argument>--extra-cpp-dirs=views</argument>
                                <argument>--extra-capi-dirs=views</argument>
                            </arguments>
                        </configuration>
                    </execution>
                    <execution>
                        <id>run-codegen-windows-platform</id>
                        <phase>generate-sources</phase>
                        <goals>
                            <goal>java</goal>
                        </goals>
                        <configuration>
                            <includePluginDependencies>true</includePluginDependencies>
                            <mainClass>net.kurobako.cef4j.codegen.Main</mainClass>
                            <arguments>
                                <argument>--cef-include=${cef.codegen.windows.dir}/include</argument>
                                <argument>--out-cpp=${project.basedir}/native/gen</argument>
                                <argument>--out-java=${project.basedir}/../cef4j-api/src/main/java</argument>
                                <argument>--java-package=${cef4j.generated.java.package}</argument>
                                <argument>--compiler=${native.compiler.id}</argument>
                                <argument>--cef-api-version=${cef.version}</argument>
                                <argument>--target-platform=${cef.codegen.windows.platform}</argument>
                                <argument>--emit-common-cpp=false</argument>
                                <argument>--emit-java-platform-only=true</argument>
                                <argument>--java-platform-subpackage=win</argument>
                                <argument>--extra-cpp-dirs=views</argument>
                                <argument>--extra-capi-dirs=views</argument>
                            </arguments>
                        </configuration>
                    </execution>
                    <execution>
                        <id>run-codegen-linux-platform-java</id>
                        <phase>generate-sources</phase>
                        <goals>
                            <goal>java</goal>
                        </goals>
                        <configuration>
                            <includePluginDependencies>true</includePluginDependencies>
                            <mainClass>net.kurobako.cef4j.codegen.Main</mainClass>
                            <arguments>
                                <argument>--cef-include=${cef.codegen.linux.dir}/include</argument>
                                <argument>--out-cpp=${project.basedir}/native/gen</argument>
                                <argument>--out-java=${project.basedir}/../cef4j-api/src/main/java</argument>
                                <argument>--java-package=${cef4j.generated.java.package}</argument>
                                <argument>--compiler=${native.compiler.id}</argument>
                                <argument>--cef-api-version=${cef.version}</argument>
                                <argument>--target-platform=${cef.codegen.linux.platform}</argument>
                                <argument>--emit-common-cpp=false</argument>
                                <argument>--emit-java-platform-only=true</argument>
                                <argument>--java-platform-subpackage=linux</argument>
                                <argument>--extra-cpp-dirs=views</argument>
                                <argument>--extra-capi-dirs=views</argument>
                            </arguments>
                        </configuration>
                    </execution>
                    <execution>
                        <id>run-cdp-codegen</id>
                        <phase>generate-sources</phase>
                        <goals><goal>java</goal></goals>
                        <configuration>
                            <includePluginDependencies>true</includePluginDependencies>
                            <mainClass>net.kurobako.cef4j.codegen.cdp.Main</mainClass>
                            <arguments>
                                <argument>--cef-version=${cef.version}</argument>
                                <argument>--schema-cache=${cef.dist.cache}</argument>
                                <argument>--out-java=${project.basedir}/../cef4j-cdp/src/main/java</argument>
                                <argument>--out-resources=${project.basedir}/../cef4j-cdp/src/main/resources</argument>
                                <argument>--java-package=net.kurobako.cef4j.cdp.generated</argument>
                            </arguments>
                        </configuration>
                    </execution>
                    <execution>
                        <id>cmake-configure</id>
                        <phase>compile</phase>
                        <goals>
                            <goal>exec</goal>
                        </goals>
                        <configuration>
                            <executable>cmake</executable>
                            <workingDirectory>${project.build.directory}/cmake-build</workingDirectory>
                            <arguments>
                                <argument>${project.basedir}</argument>
                                <argument>-G${cmake.generator}</argument>
                                <argument>-DCMAKE_TOOLCHAIN_FILE=${cmake.toolchain.file}</argument>
                                <argument>-DCEF_ROOT=${cef.dist.dir}</argument>
                                <argument>-DJAVA_HOME=${java.home}</argument>
                                <argument>-DCEF4J_API_VERSION_RAW=${cef.version}</argument>
                                <argument>-DCMAKE_BUILD_TYPE=Release</argument>
                                <argument>-DCMAKE_CXX_STANDARD=17</argument>
                                <argument>-DCMAKE_CXX_STANDARD_REQUIRED=ON</argument>
                                <argument>-DCEF4J_STATIC_RUNTIME=ON</argument>
                            </arguments>
                        </configuration>
                    </execution>
                    <execution>
                        <id>cmake-build</id>
                        <phase>compile</phase>
                        <goals>
                            <goal>exec</goal>
                        </goals>
                        <configuration>
                            <executable>cmake</executable>
                            <arguments>
                                <argument>--build</argument>
                                <argument>${project.build.directory}/cmake-build</argument>
                                <argument>--config</argument>
                                <argument>Release</argument>
                                <argument>--parallel</argument>
                            </arguments>
                        </configuration>
                    </execution>
                    <execution>
                        <id>package-cef-runtime-for-reactor-tests</id>
                        <phase>process-classes</phase>
                        <goals><goal>java</goal></goals>
                        <configuration>
                            <includePluginDependencies>true</includePluginDependencies>
                            <mainClass>net.kurobako.cef4j.packager.CefPackager</mainClass>
                            <arguments>
                                <argument>package</argument>
                                <argument>--cef-version=${cef.version}</argument>
                                <argument>--platform=${cef.platform}</argument>
                                <argument>--archive=${cef.dist.cache}/cef_binary_${cef.version}_${cef.platform}_minimal.tar.bz2</argument>
                                <argument>--bridge-directory=${project.build.directory}/cmake-build</argument>
                                <argument>--cache=${cef.dist.cache}</argument>
                                <argument>--offline</argument>
                                <argument>--locales=en-US</argument>
                                <argument>--without-swiftshader</argument>
                                <argument>--skip-if-current</argument>
                                <argument>--output=${cef4j.reactor.runtime.root}</argument>
                            </arguments>
                        </configuration>
                    </execution>
                </executions>
                <dependencies>
                    <dependency>
                        <groupId>net.kurobako.cef4j</groupId>
                        <artifactId>cef4j-codegen</artifactId>
                        <version>${project.version}</version>
                    </dependency>
                    <dependency>
                        <groupId>net.kurobako.cef4j</groupId>
                        <artifactId>cef4j-runtime-packager</artifactId>
                        <version>${cef4j.packager.version}</version>
                    </dependency>
                </dependencies>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-assembly-plugin</artifactId>
                <executions>
                    <execution>
                        <id>assemble-platform-bridge</id>
                        <phase>process-classes</phase>
                        <goals><goal>single</goal></goals>
                        <configuration>
                            <skipAssembly>${platform.assembly.skip}</skipAssembly>
                            <descriptors>
                                <descriptor>src/assembly/platform.xml</descriptor>
                            </descriptors>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>com.diffplug.spotless</groupId>
                <artifactId>spotless-maven-plugin</artifactId>
                <configuration>
                    <java>
                        <includes>
                            <include>../cef4j-api/src/main/java/net/kurobako/cef4j/gen/**/*.java</include>
                        </includes>
                        <palantirJavaFormat>
                            <version>${palantir.java.format.version}</version>
                            <style>PALANTIR</style>
                            <formatJavadoc>true</formatJavadoc>
                        </palantirJavaFormat>
                    </java>
                    <cpp>
                        <includes>
                            <include>cef4j-platform/native/gen/**/*.cpp</include>
                            <include>cef4j-platform/native/gen/**/*.h</include>
                        </includes>
                        <eclipseCdt>
                            <version>11.6</version>
                            <file>${maven.multiModuleProjectDirectory}/eclipse-cdt-format.xml</file>
                        </eclipseCdt>
                    </cpp>
                </configuration>
                <executions>
                    <execution>
                        <id>format-generated-sources</id>
                        <phase>generate-sources</phase>
                        <goals>
                            <goal>apply</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

        </plugins>
    </build>

    <dependencies>
        <dependency>
            <groupId>net.kurobako.cef4j</groupId>
            <artifactId>cef4j-cef-dist</artifactId>
            <version>${project.version}</version>
            <type>pom</type>
        </dependency>
    </dependencies>

</project>
