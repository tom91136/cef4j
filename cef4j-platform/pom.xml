<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>net.kurobako.cef4j</groupId>
        <artifactId>cef4j-parent</artifactId>
        <version>150.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>cef4j-platform</artifactId>
    <packaging>pom</packaging>
    <name>cef4j-platform</name>
    <description>Platform-specific cef4j JNI bridge and subprocess launcher</description>

    <properties>
        <exec.skip>false</exec.skip>
        <cef.codegen.linux.platform>linux64</cef.codegen.linux.platform>
        <cef.codegen.macos.platform>macosx64</cef.codegen.macos.platform>
        <cef.codegen.windows.platform>windows64</cef.codegen.windows.platform>
        <cef.codegen.linux.url>https://cef-builds.spotifycdn.com/cef_binary_${cef.version}_${cef.codegen.linux.platform}_minimal.tar.bz2</cef.codegen.linux.url>
        <cef.codegen.macos.url>https://cef-builds.spotifycdn.com/cef_binary_${cef.version}_${cef.codegen.macos.platform}_minimal.tar.bz2</cef.codegen.macos.url>
        <cef.codegen.windows.url>https://cef-builds.spotifycdn.com/cef_binary_${cef.version}_${cef.codegen.windows.platform}_minimal.tar.bz2</cef.codegen.windows.url>
        <cef.codegen.linux.dir>${cef.dist.cache}/cef_binary_${cef.version}_${cef.codegen.linux.platform}_minimal</cef.codegen.linux.dir>
        <cef.codegen.macos.dir>${cef.dist.cache}/cef_binary_${cef.version}_${cef.codegen.macos.platform}_minimal</cef.codegen.macos.dir>
        <cef.codegen.windows.dir>${cef.dist.cache}/cef_binary_${cef.version}_${cef.codegen.windows.platform}_minimal</cef.codegen.windows.dir>
    </properties>

    <build>
        <plugins>
            <!-- Step 1: Download CEF archives, then extract any missing trees below.
                 Explicit extraction is required for archives restored by Actions cache:
                 download-maven-plugin can otherwise report the archive unchanged while
                 the corresponding unpacked directory is absent on a fresh runner. -->
            <plugin>
                <groupId>com.googlecode.maven-download-plugin</groupId>
                <artifactId>download-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>download-cef</id>
                        <phase>initialize</phase>
                        <goals>
                            <goal>wget</goal>
                        </goals>
                        <configuration>
                            <url>${cef.dist.url}</url>
                            <outputDirectory>${cef.dist.cache}</outputDirectory>
                            <unpack>false</unpack>
                            <skipCache>false</skipCache>
                        </configuration>
                    </execution>
                    <execution>
                        <id>download-cef-linux-codegen</id>
                        <phase>initialize</phase>
                        <goals>
                            <goal>wget</goal>
                        </goals>
                        <configuration>
                            <url>${cef.codegen.linux.url}</url>
                            <outputDirectory>${cef.dist.cache}</outputDirectory>
                            <unpack>false</unpack>
                            <skipCache>false</skipCache>
                        </configuration>
                    </execution>
                    <execution>
                        <id>download-cef-macos-codegen</id>
                        <phase>initialize</phase>
                        <goals>
                            <goal>wget</goal>
                        </goals>
                        <configuration>
                            <url>${cef.codegen.macos.url}</url>
                            <outputDirectory>${cef.dist.cache}</outputDirectory>
                            <unpack>false</unpack>
                            <skipCache>false</skipCache>
                        </configuration>
                    </execution>
                    <execution>
                        <id>download-cef-windows-codegen</id>
                        <phase>initialize</phase>
                        <goals>
                            <goal>wget</goal>
                        </goals>
                        <configuration>
                            <url>${cef.codegen.windows.url}</url>
                            <outputDirectory>${cef.dist.cache}</outputDirectory>
                            <unpack>false</unpack>
                            <skipCache>false</skipCache>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-antrun-plugin</artifactId>
                <executions>
                    <execution>
                        <id>mkdir-cmake-build</id>
                        <phase>initialize</phase>
                        <goals>
                            <goal>run</goal>
                        </goals>
                        <configuration>
                            <target>
                                <mkdir dir="${project.build.directory}/cmake-build"/>
                            </target>
                        </configuration>
                    </execution>
                    <execution>
                        <id>extract-cef</id>
                        <phase>initialize</phase>
                        <goals><goal>run</goal></goals>
                        <configuration>
                            <target xmlns:if="ant:if" xmlns:unless="ant:unless">
                                <condition property="cef.already.extracted">
                                    <available file="${cef.dist.dir}/include/cef_version.h"/>
                                </condition>
                                <untar unless:set="cef.already.extracted"
                                       src="${cef.dist.cache}/cef_binary_${cef.version}_${cef.platform}_minimal.tar.bz2"
                                       dest="${cef.dist.cache}" compression="bzip2"/>
                            </target>
                        </configuration>
                    </execution>
                    <execution>
                        <id>extract-cef-linux-codegen</id>
                        <phase>initialize</phase>
                        <goals><goal>run</goal></goals>
                        <configuration>
                            <target xmlns:if="ant:if" xmlns:unless="ant:unless">
                                <condition property="cef.codegen.linux.extracted">
                                    <available file="${cef.codegen.linux.dir}/include/cef_version.h"/>
                                </condition>
                                <untar unless:set="cef.codegen.linux.extracted"
                                       src="${cef.dist.cache}/cef_binary_${cef.version}_${cef.codegen.linux.platform}_minimal.tar.bz2"
                                       dest="${cef.dist.cache}" compression="bzip2"/>
                            </target>
                        </configuration>
                    </execution>
                    <execution>
                        <id>extract-cef-macos-codegen</id>
                        <phase>initialize</phase>
                        <goals><goal>run</goal></goals>
                        <configuration>
                            <target xmlns:if="ant:if" xmlns:unless="ant:unless">
                                <condition property="cef.codegen.macos.extracted">
                                    <available file="${cef.codegen.macos.dir}/include/cef_version.h"/>
                                </condition>
                                <untar unless:set="cef.codegen.macos.extracted"
                                       src="${cef.dist.cache}/cef_binary_${cef.version}_${cef.codegen.macos.platform}_minimal.tar.bz2"
                                       dest="${cef.dist.cache}" compression="bzip2"/>
                            </target>
                        </configuration>
                    </execution>
                    <execution>
                        <id>extract-cef-windows-codegen</id>
                        <phase>initialize</phase>
                        <goals><goal>run</goal></goals>
                        <configuration>
                            <target xmlns:if="ant:if" xmlns:unless="ant:unless">
                                <condition property="cef.codegen.windows.extracted">
                                    <available file="${cef.codegen.windows.dir}/include/cef_version.h"/>
                                </condition>
                                <untar unless:set="cef.codegen.windows.extracted"
                                       src="${cef.dist.cache}/cef_binary_${cef.version}_${cef.codegen.windows.platform}_minimal.tar.bz2"
                                       dest="${cef.dist.cache}" compression="bzip2"/>
                            </target>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!-- Step 2: Invoke codegen -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>fetch-cdp-schema</id>
                        <phase>initialize</phase>
                        <goals><goal>exec</goal></goals>
                        <configuration>
                            <executable>bash</executable>
                            <arguments>
                                <argument>${maven.multiModuleProjectDirectory}/scripts/fetch-cdp-schema.sh</argument>
                                <argument>${cef.version}</argument>
                                <argument>${cef.dist.cache}</argument>
                            </arguments>
                        </configuration>
                    </execution>
                    <execution>
                        <id>run-codegen</id>
                        <phase>generate-sources</phase>
                        <goals>
                            <goal>java</goal>
                        </goals>
                        <configuration>
                            <includePluginDependencies>true</includePluginDependencies>
                            <mainClass>net.kurobako.cef4j.codegen.Main</mainClass>
                            <arguments>
                                <argument>--cef-include=${cef.codegen.linux.dir}/include</argument>
                                <argument>--out-cpp=${project.basedir}/native/gen</argument>
                                <argument>--out-java=${project.basedir}/../cef4j-api/src/main/java</argument>
                                <argument>--java-package=${cef4j.generated.java.package}</argument>
                                <argument>--compiler=${native.compiler.id}</argument>
                                <argument>--cef-api-version=${cef.version}</argument>
                                <argument>--target-platform=${cef.codegen.linux.platform}</argument>
                                <argument>--extra-cpp-dirs=views</argument>
                                <argument>--extra-capi-dirs=views</argument>
                            </arguments>
                        </configuration>
                    </execution>
                    <execution>
                        <id>run-codegen-macos-platform</id>
                        <phase>generate-sources</phase>
                        <goals>
                            <goal>java</goal>
                        </goals>
                        <configuration>
                            <includePluginDependencies>true</includePluginDependencies>
                            <mainClass>net.kurobako.cef4j.codegen.Main</mainClass>
                            <arguments>
                                <argument>--cef-include=${cef.codegen.macos.dir}/include</argument>
                                <argument>--out-cpp=${project.basedir}/native/gen</argument>
                                <argument>--out-java=${project.basedir}/../cef4j-api/src/main/java</argument>
                                <argument>--java-package=${cef4j.generated.java.package}</argument>
                                <argument>--compiler=${native.compiler.id}</argument>
                                <argument>--cef-api-version=${cef.version}</argument>
                                <argument>--target-platform=${cef.codegen.macos.platform}</argument>
                                <argument>--emit-common-cpp=false</argument>
                                <argument>--emit-java-platform-only=true</argument>
                                <argument>--java-platform-subpackage=mac</argument>
                                <argument>--extra-cpp-dirs=views</argument>
                                <argument>--extra-capi-dirs=views</argument>
                            </arguments>
                        </configuration>
                    </execution>
                    <execution>
                        <id>run-codegen-windows-platform</id>
                        <phase>generate-sources</phase>
                        <goals>
                            <goal>java</goal>
                        </goals>
                        <configuration>
                            <includePluginDependencies>true</includePluginDependencies>
                            <mainClass>net.kurobako.cef4j.codegen.Main</mainClass>
                            <arguments>
                                <argument>--cef-include=${cef.codegen.windows.dir}/include</argument>
                                <argument>--out-cpp=${project.basedir}/native/gen</argument>
                                <argument>--out-java=${project.basedir}/../cef4j-api/src/main/java</argument>
                                <argument>--java-package=${cef4j.generated.java.package}</argument>
                                <argument>--compiler=${native.compiler.id}</argument>
                                <argument>--cef-api-version=${cef.version}</argument>
                                <argument>--target-platform=${cef.codegen.windows.platform}</argument>
                                <argument>--emit-common-cpp=false</argument>
                                <argument>--emit-java-platform-only=true</argument>
                                <argument>--java-platform-subpackage=win</argument>
                                <argument>--extra-cpp-dirs=views</argument>
                                <argument>--extra-capi-dirs=views</argument>
                            </arguments>
                        </configuration>
                    </execution>
                    <execution>
                        <id>run-codegen-linux-platform-java</id>
                        <phase>generate-sources</phase>
                        <goals>
                            <goal>java</goal>
                        </goals>
                        <configuration>
                            <includePluginDependencies>true</includePluginDependencies>
                            <mainClass>net.kurobako.cef4j.codegen.Main</mainClass>
                            <arguments>
                                <argument>--cef-include=${cef.codegen.linux.dir}/include</argument>
                                <argument>--out-cpp=${project.basedir}/native/gen</argument>
                                <argument>--out-java=${project.basedir}/../cef4j-api/src/main/java</argument>
                                <argument>--java-package=${cef4j.generated.java.package}</argument>
                                <argument>--compiler=${native.compiler.id}</argument>
                                <argument>--cef-api-version=${cef.version}</argument>
                                <argument>--target-platform=${cef.codegen.linux.platform}</argument>
                                <argument>--emit-common-cpp=false</argument>
                                <argument>--emit-java-platform-only=true</argument>
                                <argument>--java-platform-subpackage=linux</argument>
                                <argument>--extra-cpp-dirs=views</argument>
                                <argument>--extra-capi-dirs=views</argument>
                            </arguments>
                        </configuration>
                    </execution>
                    <execution>
                        <id>run-cdp-codegen</id>
                        <phase>generate-sources</phase>
                        <goals><goal>java</goal></goals>
                        <configuration>
                            <includePluginDependencies>true</includePluginDependencies>
                            <mainClass>net.kurobako.cef4j.codegen.cdp.Main</mainClass>
                            <arguments>
                                <argument>--browser-schema=${cef.dist.cache}/cdp-${cef.chromium.version}/browser_protocol.json</argument>
                                <argument>--javascript-schema=${cef.dist.cache}/cdp-${cef.chromium.version}/js_protocol.json</argument>
                                <argument>--schema-metadata=${cef.dist.cache}/cdp-${cef.chromium.version}/schema.properties</argument>
                                <argument>--out-java=${project.basedir}/../cef4j-cdp/src/main/java</argument>
                                <argument>--out-resources=${project.basedir}/../cef4j-cdp/src/main/resources</argument>
                                <argument>--java-package=net.kurobako.cef4j.cdp.generated</argument>
                            </arguments>
                        </configuration>
                    </execution>
                    <execution>
                        <id>cmake-configure</id>
                        <phase>compile</phase>
                        <goals>
                            <goal>exec</goal>
                        </goals>
                        <configuration>
                            <executable>cmake</executable>
                            <workingDirectory>${project.build.directory}/cmake-build</workingDirectory>
                            <arguments>
                                <argument>${project.basedir}</argument>
                                <argument>-G${cmake.generator}</argument>
                                <argument>-DCMAKE_TOOLCHAIN_FILE=${cmake.toolchain.file}</argument>
                                <argument>-DCEF_ROOT=${cef.dist.dir}</argument>
                                <argument>-DJAVA_HOME=${java.home}</argument>
                                <argument>-DCEF4J_API_VERSION_RAW=${cef.version}</argument>
                                <argument>-DCMAKE_BUILD_TYPE=Release</argument>
                                <argument>-DCMAKE_CXX_STANDARD=17</argument>
                                <argument>-DCMAKE_CXX_STANDARD_REQUIRED=ON</argument>
                                <argument>-DCEF4J_STATIC_RUNTIME=ON</argument>
                            </arguments>
                        </configuration>
                    </execution>
                    <execution>
                        <id>cmake-build</id>
                        <phase>compile</phase>
                        <goals>
                            <goal>exec</goal>
                        </goals>
                        <configuration>
                            <executable>cmake</executable>
                            <arguments>
                                <argument>--build</argument>
                                <argument>${project.build.directory}/cmake-build</argument>
                                <argument>--config</argument>
                                <argument>Release</argument>
                                <argument>--parallel</argument>
                            </arguments>
                        </configuration>
                    </execution>
                    <execution>
                        <id>package-cef-runtime-for-reactor-tests</id>
                        <phase>process-classes</phase>
                        <goals><goal>java</goal></goals>
                        <configuration>
                            <includePluginDependencies>true</includePluginDependencies>
                            <mainClass>net.kurobako.cef4j.packager.CefPackager</mainClass>
                            <arguments>
                                <argument>package</argument>
                                <argument>--cef-version=${cef.version}</argument>
                                <argument>--platform=${cef.platform}</argument>
                                <argument>--archive=${cef.dist.cache}/cef_binary_${cef.version}_${cef.platform}_minimal.tar.bz2</argument>
                                <argument>--cache=${cef.dist.cache}</argument>
                                <argument>--offline</argument>
                                <argument>--locales=en-US</argument>
                                <argument>--without-swiftshader</argument>
                                <argument>--skip-if-current</argument>
                                <argument>--output=${project.basedir}/../cef4j-api/target/classes</argument>
                            </arguments>
                        </configuration>
                    </execution>
                </executions>
                <dependencies>
                    <dependency>
                        <groupId>net.kurobako.cef4j</groupId>
                        <artifactId>cef4j-codegen</artifactId>
                        <version>${project.version}</version>
                    </dependency>
                    <dependency>
                        <groupId>net.kurobako.cef4j</groupId>
                        <artifactId>cef4j-runtime-packager</artifactId>
                        <version>${cef4j.packager.version}</version>
                    </dependency>
                </dependencies>
            </plugin>

            <!-- Stage only cef4j's JNI bridge and launcher. CEF itself is prepared above by
                 the same runtime packager and classpath layout used by downstream applications. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-resources-plugin</artifactId>
                <executions>
                    <execution>
                        <id>stage-reactor-classpath-bridge</id>
                        <phase>process-classes</phase>
                        <goals>
                            <goal>copy-resources</goal>
                        </goals>
                        <configuration>
                            <!-- The classified platform JAR is attached at package. Staging into the API
                                 output makes reactor tests exercise classpath extraction using this build's bridge. -->
                            <outputDirectory>${project.basedir}/../cef4j-api/target/classes/native/${cef.platform}</outputDirectory>
                            <resources>
                                <resource>
                                    <directory>${project.build.directory}/cmake-build</directory>
                                    <includes>
                                        <include>libcef4j.so</include>
                                        <include>cef4j.dll</include>
                                        <include>libcef4j.dylib</include>
                                        <include>cef4j_launcher</include>
                                        <include>cef4j_launcher.exe</include>
                                    </includes>
                                </resource>
                            </resources>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-assembly-plugin</artifactId>
                <executions>
                    <execution>
                        <id>assemble-platform-bridge</id>
                        <phase>package</phase>
                        <goals><goal>single</goal></goals>
                        <configuration>
                            <skipAssembly>${platform.assembly.skip}</skipAssembly>
                            <descriptors>
                                <descriptor>src/assembly/platform.xml</descriptor>
                            </descriptors>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>com.diffplug.spotless</groupId>
                <artifactId>spotless-maven-plugin</artifactId>
                <configuration>
                    <java>
                        <includes>
                            <include>../cef4j-api/src/main/java/net/kurobako/cef4j/gen/**/*.java</include>
                        </includes>
                        <palantirJavaFormat>
                            <version>${palantir.java.format.version}</version>
                            <style>PALANTIR</style>
                            <formatJavadoc>true</formatJavadoc>
                        </palantirJavaFormat>
                    </java>
                    <cpp>
                        <includes>
                            <include>cef4j-platform/native/gen/**/*.cpp</include>
                            <include>cef4j-platform/native/gen/**/*.h</include>
                        </includes>
                        <eclipseCdt>
                            <version>11.6</version>
                            <file>${maven.multiModuleProjectDirectory}/eclipse-cdt-format.xml</file>
                        </eclipseCdt>
                    </cpp>
                </configuration>
                <executions>
                    <execution>
                        <id>format-generated-sources</id>
                        <phase>generate-sources</phase>
                        <goals>
                            <goal>apply</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

        </plugins>
    </build>

</project>
