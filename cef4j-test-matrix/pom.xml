<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>net.kurobako.cef4j</groupId>
        <artifactId>cef4j-parent</artifactId>
        <version>146.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>cef4j-test-matrix</artifactId>
    <packaging>jar</packaging>
    <name>cef4j-test-matrix</name>
    <description>Cross-backend integration tests — runs the same scenario against both NativeBrowserBackend (in-process JCEF) and IpcBrowserBackend (helper subprocess). Pulls both impls in via test-jar deps so a single ServiceLoader scan discovers both.</description>

    <properties>
        <!-- This module needs JFX at test time for NativeBrowserBackend (its session opens a JFX Stage).
             Use 13.0.2 throughout to avoid the JFX-graphics:11 + JFX-base:13.0.2 mix that tripped a SIGSEGV
             in glassgtk3 staticScreen_getScreens (the transitive dep from cef4j-osr-jfx forces base to 13.0.2,
             so graphics must match). -->
        <javafx.version>13.0.2</javafx.version>
        <javafx.test.version>13.0.2</javafx.test.version>
    </properties>

    <dependencies>
        <!-- The SPI itself. -->
        <dependency>
            <groupId>net.kurobako.cef4j</groupId>
            <artifactId>cef4j-test-shared</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>

        <!-- Backend impls live in the respective modules' test scopes — pulled in via test-jar deps so
             their META-INF/services BrowserBackend registration files land on this module's classpath
             and ServiceLoader.load(BrowserBackend.class) discovers both impls. -->
        <dependency>
            <groupId>net.kurobako.cef4j</groupId>
            <artifactId>cef4j-ipc-frame-mmap</artifactId>
            <version>${project.version}</version>
            <type>test-jar</type>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>net.kurobako.cef4j</groupId>
            <artifactId>cef4j-ipc-frame-mmap</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>net.kurobako.cef4j</groupId>
            <artifactId>cef4j-osr-jfx</artifactId>
            <version>${project.version}</version>
            <type>test-jar</type>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>net.kurobako.cef4j</groupId>
            <artifactId>cef4j-osr-jfx</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <!-- libcef.so / Chromium runtime files for the native backend. Same classifier-based selection as
             cef4j-osr-jfx; the classifier is set per-platform by profiles in the parent pom. -->
        <dependency>
            <groupId>net.kurobako.cef4j</groupId>
            <artifactId>cef4j-platform</artifactId>
            <version>${project.version}</version>
            <classifier>${cef.platform}</classifier>
            <scope>test</scope>
        </dependency>

        <!-- Transitive runtime needs: each backend's session pulls in its own runtime deps, but we still
             need test-scoped JUnit/AssertJ for the matrix tests themselves. -->
        <!-- JavaFX runtime for the native backend's Stage. The test-version (11) ships unclassified jars
             that auto-resolve native libs; cef4j-osr-jfx uses the same pattern. -->
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-graphics</artifactId>
            <version>${javafx.test.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-controls</artifactId>
            <version>${javafx.test.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-simple</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>com.diffplug.spotless</groupId>
                <artifactId>spotless-maven-plugin</artifactId>
            </plugin>
            <plugin>
                <!-- Same fork-per-class story as cef4j-ipc-frame-mmap: jeromq's iothread can't survive
                     many ZContext lifecycles in the same JVM. Each test class in this matrix module gets
                     its own JVM so cumulative ZContext state never trips the close-time NPE.
                     System properties mirror cef4j-osr-jfx: JFX needs headless=false (surefire default
                     would crash glassgtk3 in XInternAtom) and the native backend needs cef4j.libcef.dir
                     to find libcef.so. -->
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <systemPropertyVariables>
                        <cef4j.libcef.dir>${cef.dist.dir}/Release</cef4j.libcef.dir>
                        <cef4j.disableStderrRedirect>true</cef4j.disableStderrRedirect>
                        <java.awt.headless>false</java.awt.headless>
                        <cef4j.ipc.helper.binary>${maven.multiModuleProjectDirectory}/cef4j-ipc-helper-native/target/cmake-build/cef4j-helper</cef4j.ipc.helper.binary>
                        <cef4j.ipc.cef.resources>${cef.dist.dir}/Release</cef4j.ipc.cef.resources>
                    </systemPropertyVariables>
                    <reuseForks>false</reuseForks>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
