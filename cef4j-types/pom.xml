<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>net.kurobako.cef4j</groupId>
        <artifactId>cef4j-parent</artifactId>
        <version>150.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>cef4j-types</artifactId>
    <name>cef4j-types</name>
    <description>Generated CEF types: enums, structs, object interfaces and native peers</description>

    <properties>
        <cef4j.module.name>net.kurobako.cef4j.types</cef4j.module.name>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.jspecify</groupId>
            <artifactId>jspecify</artifactId>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
        </dependency>
        <dependency>
            <groupId>com.google.errorprone</groupId>
            <artifactId>error_prone_annotations</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>net.kurobako.cef4j</groupId>
            <artifactId>cef4j-code-policy</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>generate-cef-types</id>
                        <phase>generate-sources</phase>
                        <goals><goal>java</goal></goals>
                        <configuration>
                            <includePluginDependencies>true</includePluginDependencies>
                            <mainClass>net.kurobako.cef4j.codegen.Main</mainClass>
                            <arguments>
                                <argument>--cef-include=${cef.codegen.linux.dir}/include</argument>
                                <argument>--out-cpp=${project.build.directory}/discarded-codegen-cpp</argument>
                                <argument>--out-java=${project.basedir}/src/main/java</argument>
                                <argument>--java-package=${cef4j.generated.java.package}</argument>
                                <argument>--compiler=${native.compiler.id}</argument>
                                <argument>--cef-api-version=${cef.version}</argument>
                                <argument>--target-platform=${cef.codegen.linux.platform}</argument>
                                <argument>--emit-common-cpp=false</argument>
                                <argument>--regenerate-command=./mvnw generate-sources -pl cef4j-types -Dcef.version=${cef.version}</argument>
                                <argument>--extra-cpp-dirs=views</argument>
                                <argument>--extra-capi-dirs=views</argument>
                            </arguments>
                        </configuration>
                    </execution>
                    <execution>
                        <id>generate-cef-types-macos-platform</id>
                        <phase>generate-sources</phase>
                        <goals><goal>java</goal></goals>
                        <configuration>
                            <includePluginDependencies>true</includePluginDependencies>
                            <mainClass>net.kurobako.cef4j.codegen.Main</mainClass>
                            <arguments>
                                <argument>--cef-include=${cef.codegen.macos.dir}/include</argument>
                                <argument>--out-cpp=${project.build.directory}/discarded-codegen-cpp</argument>
                                <argument>--out-java=${project.basedir}/src/main/java</argument>
                                <argument>--java-package=${cef4j.generated.java.package}</argument>
                                <argument>--compiler=${native.compiler.id}</argument>
                                <argument>--cef-api-version=${cef.version}</argument>
                                <argument>--target-platform=${cef.codegen.macos.platform}</argument>
                                <argument>--emit-common-cpp=false</argument>
                                <argument>--emit-java-platform-only=true</argument>
                                <argument>--java-platform-subpackage=mac</argument>
                                <argument>--regenerate-command=./mvnw generate-sources -pl cef4j-types -Dcef.version=${cef.version}</argument>
                                <argument>--extra-cpp-dirs=views</argument>
                                <argument>--extra-capi-dirs=views</argument>
                            </arguments>
                        </configuration>
                    </execution>
                    <execution>
                        <id>generate-cef-types-windows-platform</id>
                        <phase>generate-sources</phase>
                        <goals><goal>java</goal></goals>
                        <configuration>
                            <includePluginDependencies>true</includePluginDependencies>
                            <mainClass>net.kurobako.cef4j.codegen.Main</mainClass>
                            <arguments>
                                <argument>--cef-include=${cef.codegen.windows.dir}/include</argument>
                                <argument>--out-cpp=${project.build.directory}/discarded-codegen-cpp</argument>
                                <argument>--out-java=${project.basedir}/src/main/java</argument>
                                <argument>--java-package=${cef4j.generated.java.package}</argument>
                                <argument>--compiler=${native.compiler.id}</argument>
                                <argument>--cef-api-version=${cef.version}</argument>
                                <argument>--target-platform=${cef.codegen.windows.platform}</argument>
                                <argument>--emit-common-cpp=false</argument>
                                <argument>--emit-java-platform-only=true</argument>
                                <argument>--java-platform-subpackage=win</argument>
                                <argument>--regenerate-command=./mvnw generate-sources -pl cef4j-types -Dcef.version=${cef.version}</argument>
                                <argument>--extra-cpp-dirs=views</argument>
                                <argument>--extra-capi-dirs=views</argument>
                            </arguments>
                        </configuration>
                    </execution>
                    <execution>
                        <id>generate-cef-types-linux-platform</id>
                        <phase>generate-sources</phase>
                        <goals><goal>java</goal></goals>
                        <configuration>
                            <includePluginDependencies>true</includePluginDependencies>
                            <mainClass>net.kurobako.cef4j.codegen.Main</mainClass>
                            <arguments>
                                <argument>--cef-include=${cef.codegen.linux.dir}/include</argument>
                                <argument>--out-cpp=${project.build.directory}/discarded-codegen-cpp</argument>
                                <argument>--out-java=${project.basedir}/src/main/java</argument>
                                <argument>--java-package=${cef4j.generated.java.package}</argument>
                                <argument>--compiler=${native.compiler.id}</argument>
                                <argument>--cef-api-version=${cef.version}</argument>
                                <argument>--target-platform=${cef.codegen.linux.platform}</argument>
                                <argument>--emit-common-cpp=false</argument>
                                <argument>--emit-java-platform-only=true</argument>
                                <argument>--java-platform-subpackage=linux</argument>
                                <argument>--regenerate-command=./mvnw generate-sources -pl cef4j-types -Dcef.version=${cef.version}</argument>
                                <argument>--extra-cpp-dirs=views</argument>
                                <argument>--extra-capi-dirs=views</argument>
                            </arguments>
                        </configuration>
                    </execution>
                </executions>
                <dependencies>
                    <dependency>
                        <groupId>net.kurobako.cef4j</groupId>
                        <artifactId>cef4j-codegen</artifactId>
                        <version>${project.version}</version>
                    </dependency>
                </dependencies>
            </plugin>
            <plugin>
                <groupId>com.diffplug.spotless</groupId>
                <artifactId>spotless-maven-plugin</artifactId>
                <configuration>
                    <java>
                        <excludes>
                            <exclude>src/main/java/net/kurobako/cef4j/gen/**/*.java</exclude>
                        </excludes>
                    </java>
                </configuration>
                <executions>
                    <execution>
                        <id>format-generated-cef-types</id>
                        <phase>generate-sources</phase>
                        <goals><goal>apply</goal></goals>
                        <configuration>
                            <java>
                                <includes>
                                    <include>src/main/java/net/kurobako/cef4j/gen/**/*.java</include>
                                </includes>
                                <excludes combine.self="override"/>
                            </java>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
