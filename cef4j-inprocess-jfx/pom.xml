<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>net.kurobako.cef4j</groupId>
        <artifactId>cef4j-parent</artifactId>
        <version>150.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>cef4j-inprocess-jfx</artifactId>
    <name>cef4j-inprocess-jfx</name>
    <description>In-process JavaFX browser pane for cef4j (requires JavaFX 13+)</description>

    <properties>
        <!-- PixelBuffer requires JavaFX 13+; compile against the lowest supported version -->
        <javafx.version>13.0.2</javafx.version>
        <!-- Keep the test runtime coherent with the JavaFX 13 PixelBuffer baseline. -->
        <javafx.test.version>13.0.2</javafx.test.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>net.kurobako.cef4j</groupId>
            <artifactId>cef4j-api</artifactId>
        </dependency>
        <dependency>
            <groupId>net.kurobako.cef4j</groupId>
            <artifactId>cef4j-code-policy</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-base</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-graphics</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-controls</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-web</artifactId>
            <version>${javafx.test.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>net.kurobako.cef4j</groupId>
            <artifactId>cef4j-platform</artifactId>
            <classifier>${cef.classifier}</classifier>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-simple</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <!-- Lets the in-process JFX tests share one parameterised harness with the IPC backend. -->
            <groupId>net.kurobako.cef4j</groupId>
            <artifactId>cef4j-test-shared</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                                        <testExcludes>
                        <testExclude>${cef4j.test.v117plus.excludes}</testExclude>
                    </testExcludes>
                    <testIncrementalExcludes>
                        <testIncrementalExclude>${cef4j.test.v117plus.excludes}</testIncrementalExclude>
                    </testIncrementalExcludes>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <!-- JavaFX needs a real display; surefire defaults java.awt.headless=true. -->
                    <systemPropertyVariables>
                        <cef4j.disableStderrRedirect>true</cef4j.disableStderrRedirect>
                        <java.awt.headless>false</java.awt.headless>
                    </systemPropertyVariables>
                    <reuseForks>false</reuseForks>
                    <excludes>
                        <exclude>**/CefWebView*.java</exclude>
                        <exclude>**/compat/cef/**</exclude>
                    </excludes>
                </configuration>
                <executions>
                    <execution>
                        <id>cef-tests</id>
                        <goals><goal>test</goal></goals>
                        <configuration>
                            <!-- Fresh JVM per class: CefWebView tests leave CEF state behind. -->
                            <reuseForks>false</reuseForks>
                            <excludes combine.self="override"/>
                            <includes>
                                <include>**/CefWebView*.java</include>
                                <include>**/compat/cef/**</include>
                            </includes>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>com.diffplug.spotless</groupId>
                <artifactId>spotless-maven-plugin</artifactId>
            </plugin>
            <plugin>
                <!-- Publish a test-jar so cef4j-integration-tests can reuse NativeBrowserBackend. -->
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <executions>
                    <execution>
                        <phase>process-test-classes</phase>
                        <goals>
                            <goal>test-jar</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-antrun-plugin</artifactId>
                <executions>
                    <execution>
                        <id>bucket-v117-plus-tests</id>
                        <phase>initialize</phase>
                        <goals>
                            <goal>run</goal>
                        </goals>
                        <configuration>
                            <exportAntProperties>true</exportAntProperties>
                            <target>
                                <condition property="cef4j.test.v117plus.excludes"
                                           value="__never__"
                                           else="**/*V117Plus*.java">
                                    <matches string="${cef.version}"
                                             pattern="^(11[7-9]|1[2-9][0-9]|[2-9][0-9]{2,})\..*"/>
                                </condition>
                            </target>
                        </configuration>
                    </execution>
                    <execution>
                        <id>generate-cef-compat-tests</id>
                        <phase>generate-test-sources</phase>
                        <goals>
                            <goal>run</goal>
                        </goals>
                        <configuration>
                            <target>
                                <property name="compat.src" value="${project.basedir}/src/test/java/net/kurobako/cef4j/osr/jfx/compat/javafx"/>
                                <property name="compat.out" value="${project.build.directory}/generated-test-sources/cef-compat/net/kurobako/cef4j/osr/jfx/compat/cef"/>
                                <delete dir="${compat.out}" quiet="true"/>
                                <copy todir="${compat.out}" overwrite="true">
                                    <fileset dir="${compat.src}" includes="**/*.java"/>
                                    <filterchain>
                                        <tokenfilter>
                                            <replacestring from="package net.kurobako.cef4j.osr.jfx.compat.javafx;" to="package net.kurobako.cef4j.osr.jfx.compat.cef;"/>
                                            <replacestring from="import static net.kurobako.cef4j.osr.jfx.compat.javafx.FxWebViewRuntimeTestSupport.*;" to="import static net.kurobako.cef4j.osr.jfx.compat.cef.FxWebViewRuntimeTestSupport.*;"/>
                                            <replacestring from="import javafx.scene.web.WebView;" to="import net.kurobako.cef4j.osr.jfx.CefWebView;"/>
                                            <replacestring from="import javafx.scene.web.WebEngine;" to="import net.kurobako.cef4j.osr.jfx.CefWebEngine;"/>
                                            <replacestring from="import javafx.scene.web.WebHistory;" to="import net.kurobako.cef4j.osr.jfx.CefWebHistory;"/>
                                            <replacestring from="import javafx.scene.web.PopupFeatures;" to="import net.kurobako.cef4j.osr.jfx.CefPopupFeatures;"/>
                                            <replacestring from="import javafx.scene.web.PromptData;" to="import net.kurobako.cef4j.osr.jfx.CefPromptData;"/>
                                            <replacestring from="import javafx.scene.web.WebErrorEvent;" to="import net.kurobako.cef4j.osr.jfx.CefWebErrorEvent;"/>
                                            <replacestring from="import javafx.scene.web.WebEvent;" to="import net.kurobako.cef4j.osr.jfx.CefWebEvent;"/>
                                            <replaceregex pattern="\bWebView\b" replace="CefWebView" flags="g"/>
                                            <replaceregex pattern="\bWebEngine\b" replace="CefWebEngine" flags="g"/>
                                            <replaceregex pattern="\bWebHistory\b" replace="CefWebHistory" flags="g"/>
                                            <replaceregex pattern="\bPopupFeatures\b" replace="CefPopupFeatures" flags="g"/>
                                            <replaceregex pattern="\bPromptData\b" replace="CefPromptData" flags="g"/>
                                            <replaceregex pattern="\bWebErrorEvent\b" replace="CefWebErrorEvent" flags="g"/>
                                            <replaceregex pattern="\bWebEvent\b" replace="CefWebEvent" flags="g"/>
                                        </tokenfilter>
                                    </filterchain>
                                </copy>
                            </target>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>build-helper-maven-plugin</artifactId>
                <version>3.6.1</version>
                <executions>
                    <execution>
                        <id>add-generated-cef-compat-tests</id>
                        <phase>generate-test-sources</phase>
                        <goals>
                            <goal>add-test-source</goal>
                        </goals>
                        <configuration>
                            <sources>
                                <source>${project.build.directory}/generated-test-sources/cef-compat</source>
                            </sources>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!-- macOS arm64: JavaFX 13.0.2 has no arm64 native lib in Maven Central; use 23.0.2.
             The provided-scope deps transitively pull in javafx-*-23.0.2-mac-aarch64.jar which
             contains both the Java classes (compile) and native .dylib files (test runtime). -->
        <profile>
            <id>javafx-macos-aarch64</id>
            <activation>
                <os>
                    <name>Mac OS X</name>
                    <arch>aarch64</arch>
                </os>
            </activation>
            <properties>
                <javafx.version>23.0.2</javafx.version>
                <javafx.test.version>23.0.2</javafx.test.version>
            </properties>
        </profile>
        <!-- macOS x86_64: use 23.0.2 for test consistency with arm64. -->
        <profile>
            <id>javafx-macos-x86_64</id>
            <activation>
                <os>
                    <name>Mac OS X</name>
                    <arch>x86_64</arch>
                </os>
            </activation>
            <properties>
                <javafx.version>23.0.2</javafx.version>
                <javafx.test.version>23.0.2</javafx.test.version>
            </properties>
        </profile>

    </profiles>
</project>
