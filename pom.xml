    <profiles>
        <profile>
            <id>release</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-source-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>attach-sources</id>
                                <goals><goal>jar-no-fork</goal></goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-javadoc-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>verify-javadocs</id>
                                <goals><goal>jar</goal></goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-gpg-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>sign-artifacts</id>
                                <phase>verify</phase>
                                <goals><goal>sign</goal></goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.sonatype.central</groupId>
                        <artifactId>central-publishing-maven-plugin</artifactId>
                        <extensions>true</extensions>
                        <configuration>
                            <publishingServerId>central</publishingServerId>
                            <autoPublish>false</autoPublish>
                            <!-- Thin native bridges are assembled into one companion Central deployment.
                                 Build-only, aggregator, and test-only reactor modules are excluded here. -->
                            <excludeArtifacts>
                                <excludeArtifact>cef4j-codegen</excludeArtifact>
                                <excludeArtifact>cef4j-platform</excludeArtifact>
                                <excludeArtifact>cef4j-runtime-server</excludeArtifact>
                                <excludeArtifact>cef4j-test-shared</excludeArtifact>
                                <excludeArtifact>cef4j-integration-tests</excludeArtifact>
                                <excludeArtifact>cef4j-sample</excludeArtifact>
                            </excludeArtifacts>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>

        <!-- Manual Error Prone/NullAway opt-out: -Derrorprone.skip=true. -->
        <profile>
            <id>disable-errorprone-opt-out</id>
            <activation>
                <property>
                    <name>errorprone.skip</name>
                    <value>true</value>
                </property>
            </activation>
            <build>
                <pluginManagement>
                    <plugins>
                        <plugin>
                            <groupId>org.apache.maven.plugins</groupId>
                            <artifactId>maven-compiler-plugin</artifactId>
                            <configuration>
                                <compilerArgs combine.self="override">
                                    <arg>-Xlint:all</arg>
                                    <arg>-Xlint:-options</arg>
                                    <arg>-Xlint:-processing</arg>
                                </compilerArgs>
                                <annotationProcessorPaths combine.self="override"/>
                            </configuration>
                        </plugin>
                    </plugins>
                </pluginManagement>
            </build>
        </profile>

        <!-- setup-java writes all configured JDKs to Maven's toolchains.xml. This profile
             lets CI build with JDK 17 while forking a focused runtime smoke test on JDK 11. -->
        <profile>
            <id>java11-runtime-smoke</id>
            <activation>
                <property>
                    <name>java11.runtime.smoke</name>
                    <value>true</value>
                </property>
            </activation>
            <build>
                <pluginManagement>
                    <plugins>
                        <plugin>
                            <groupId>org.apache.maven.plugins</groupId>
                            <artifactId>maven-surefire-plugin</artifactId>
                            <configuration>
                                <jdkToolchain>
                                    <version>11</version>
                                </jdkToolchain>
                            </configuration>
                        </plugin>
                    </plugins>
                </pluginManagement>
            </build>
        </profile>

        <!-- Platform detection - activated automatically -->
        <profile>
            <id>linux-x86_64</id>
            <activation>
                <os>
                    <name>Linux</name>
                    <arch>amd64</arch>
                </os>
            </activation>
            <properties>
                <cef.platform>linux64</cef.platform>
                <cef.classifier>linux-x86_64</cef.classifier>
                <cef.dist.url>https://cef-builds.spotifycdn.com/cef_binary_${cef.version}_linux64_minimal.tar.bz2</cef.dist.url>
                <cmake.generator>Unix Makefiles</cmake.generator>
                <cmake.toolchain.file>${maven.multiModuleProjectDirectory}/cmake/toolchains/linux-x86_64.cmake</cmake.toolchain.file>
