<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>net.kurobako.cef4j</groupId>
    <artifactId>cef4j-parent</artifactId>
    <version>150.0.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>cef4j</name>
    <description>Code-generated, OSR-only Java CEF binding</description>
    <url>https://github.com/${github.user}/${github.repo}</url>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
        <github.user>tom91136</github.user>
        <github.repo>cef4j</github.repo>

        <cef.version>150.0.18+gdb11278+chromium-150.0.7871.213</cef.version>
        <!-- Derived automatically from cef.version by build-helper-maven-plugin below.
             Kept here as a fallback for IDE resolution; the plugin always overrides it. -->
        <cef.api.version>150</cef.api.version>
        <cef.dist.cache>${maven.multiModuleProjectDirectory}/.cef-dist</cef.dist.cache>
        <cef.dist.dir>${cef.dist.cache}/cef_binary_${cef.version}_${cef.platform}_minimal</cef.dist.dir>
        <cef4j.packager.version>0.1.0-SNAPSHOT</cef4j.packager.version>
        <cef4j.reactor.runtime.dir>${maven.multiModuleProjectDirectory}/cef4j-api/target/classes/cef-runtime/${cef.platform}</cef4j.reactor.runtime.dir>
        <runtime.server.executable>cef4j-runtime-server</runtime.server.executable>

        <!-- Dependency versions -->
        <scala.version>3.8.4</scala.version>
        <munit.version>1.3.5</munit.version>
        <jsr305.version>3.0.2</jsr305.version>
        <slf4j.version>2.0.18</slf4j.version>
        <junit.jupiter.version>5.14.4</junit.jupiter.version>
        <assertj.version>3.27.7</assertj.version>
        <mockito.version>5.23.0</mockito.version>
        <javafx.version>11.0.2</javafx.version>
        <flatlaf.version>3.7.2</flatlaf.version>
        <palantir.java.format.version>2.97.0</palantir.java.format.version>
        <errorprone.version>2.42.0</errorprone.version>
        <nullaway.version>0.13.8</nullaway.version>
        <autoservice.version>1.1.1</autoservice.version>
        <jeromq.version>0.6.0</jeromq.version>
        <junixsocket.version>2.11.0</junixsocket.version>
        <gson.version>2.14.0</gson.version>
        <jackson.version>2.22.2</jackson.version>
        <selenium.version>4.47.0</selenium.version>
        <spotbugs.version>4.10.3.0</spotbugs.version>
        <maven.source.version>3.4.0</maven.source.version>
        <maven.release.version>3.3.1</maven.release.version>
        <maven.gpg.version>3.2.8</maven.gpg.version>
        <central.publishing.version>0.11.0</central.publishing.version>
        <platform.assembly.skip>false</platform.assembly.skip>
        <!-- Per-module opt-out; SpotBugs is disabled in modules where it is noisy (e.g. Scala codegen). -->
        <spotbugs.skip>false</spotbugs.skip>
        <!-- Java 17-only build tooling (currently cef4j-codegen) overrides this. -->
        <bytecode.check.skip>false</bytecode.check.skip>

        <!-- exec-maven-plugin: skip by default, override in modules that need it.
             Dummy mainClass required because Maven validates required params before checking skip. -->
        <exec.skip>true</exec.skip>
        <exec.mainClass>none</exec.mainClass>

        <!-- Resolved by platform-detection profile below -->
        <cef.platform/>
        <cef.classifier/>
        <cef.dist.url/>
        <cmake.generator/>
        <cmake.toolchain.file>${maven.multiModuleProjectDirectory}/cmake/toolchains/default.cmake</cmake.toolchain.file>
        <native.compiler.id/>
        <cef4j.generated.java.package>net.kurobako.cef4j.gen</cef4j.generated.java.package>

        <!-- Extra JVM args for Surefire; empty by default. Override via -Dsurefire.argLine=... if needed. -->
        <surefire.argLine/>
    </properties>

    <modules>
        <module>cef4j-codegen</module>
        <module>cef4j-platform</module>
        <module>cef4j-platform-all</module>
        <module>cef4j-api</module>
        <module>cef4j-inprocess-swing</module>
        <module>cef4j-inprocess-jfx</module>
        <module>cef4j-http</module>
        <module>cef4j-cdp</module>
        <module>cef4j-codecs-jackson</module>
        <module>cef4j-codecs-gson</module>
        <module>cef4j-remote-core</module>
        <module>cef4j-runtime-server</module>
        <module>cef4j-runtime-server-all</module>
        <module>cef4j-runtime-packager</module>
        <module>cef4j-remote-api</module>
        <module>cef4j-remote-frame</module>
        <module>cef4j-remote-jfx</module>
        <module>cef4j-remote-swing</module>
        <module>cef4j-webdriver</module>
