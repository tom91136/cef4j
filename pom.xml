                </os>
            </activation>
            <properties>
                <cef.platform>windowsarm64</cef.platform>
                <cef.classifier>windows-arm64</cef.classifier>
                <cef.dist.url>https://cef-builds.spotifycdn.com/cef_binary_${cef.version}_windowsarm64_minimal.tar.bz2</cef.dist.url>
