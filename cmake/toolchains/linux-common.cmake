if(DEFINED ENV{CMAKE_SYSROOT} AND NOT "$ENV{CMAKE_SYSROOT}" STREQUAL "")
    set(CMAKE_SYSROOT "$ENV{CMAKE_SYSROOT}")

    if(NOT CMAKE_HOST_SYSTEM_PROCESSOR MATCHES "${CEF4J_HOST_PROCESSOR_REGEX}")
        set(CMAKE_SYSTEM_NAME Linux)
        set(CMAKE_SYSTEM_PROCESSOR "${CEF4J_SYSTEM_PROCESSOR}")
    endif()

    set(CMAKE_C_COMPILER clang)
    set(CMAKE_CXX_COMPILER clang++)
    set(CMAKE_C_COMPILER_TARGET "${CEF4J_TARGET_TRIPLE}")
    set(CMAKE_CXX_COMPILER_TARGET "${CEF4J_TARGET_TRIPLE}")
    string(APPEND CMAKE_C_FLAGS_INIT " -fPIC ${CEF4J_EXTRA_FLAGS}")
    string(APPEND CMAKE_CXX_FLAGS_INIT " -fPIC ${CEF4J_EXTRA_FLAGS}")
    set(CMAKE_POSITION_INDEPENDENT_CODE ON)

    include("${CMAKE_CURRENT_LIST_DIR}/../sysroot-gcc-dir.cmake")
    if(CEF4J_SYSROOT_GCC_INSTALL_DIR)
        string(APPEND CMAKE_C_FLAGS_INIT " --gcc-install-dir=${CEF4J_SYSROOT_GCC_INSTALL_DIR}")
        string(APPEND CMAKE_CXX_FLAGS_INIT " --gcc-install-dir=${CEF4J_SYSROOT_GCC_INSTALL_DIR}")
    endif()

    foreach(_cef4j_kind SHARED MODULE EXE)
        string(APPEND CMAKE_${_cef4j_kind}_LINKER_FLAGS_INIT " -fuse-ld=lld")
    endforeach()

    set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
    set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
    set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
    set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)
endif()
