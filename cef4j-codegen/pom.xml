<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>net.kurobako.cef4j</groupId>
        <artifactId>cef4j-parent</artifactId>
        <version>150.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>cef4j-codegen</artifactId>
    <name>cef4j-codegen</name>
    <description>Scala 3 code generator for CEF Java bindings</description>

    <properties>
        <!-- SpotBugs misfires on idiomatic Scala 3 bytecode (closures, inlined values, pattern-match
             lowerings). Not worth chasing; NullAway + Error Prone only run on Java, so this module is
             linted via Scala's own compiler warnings. -->
        <spotbugs.skip>true</spotbugs.skip>
        <!-- maven-dependency-analyzer does not understand Scala 3's library and inline references. -->
        <dependency.analyze.skip>true</dependency.analyze.skip>
        <!-- Scala 3.8 and the shaded code generator intentionally require Java 17. -->
        <bytecode.check.skip>true</bytecode.check.skip>
        <codegen.test.argLine/>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.scala-lang</groupId>
            <artifactId>scala3-library_3</artifactId>
        </dependency>
        <dependency>
            <groupId>org.typelevel</groupId>
            <artifactId>cats-core_3</artifactId>
        </dependency>
        <dependency>
            <groupId>net.kurobako.cef4j</groupId>
            <artifactId>cef4j-code-policy</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>com.lihaoyi</groupId>
            <artifactId>ujson_3</artifactId>
        </dependency>
        <dependency>
            <groupId>org.apache.commons</groupId>
            <artifactId>commons-compress</artifactId>
        </dependency>
        <dependency>
            <groupId>org.scalameta</groupId>
            <artifactId>munit_3</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <sourceDirectory>src/main/scala</sourceDirectory>
        <testSourceDirectory>src/test/scala</testSourceDirectory>
        <plugins>
            <plugin>
                <groupId>net.alchim31.maven</groupId>
                <artifactId>scala-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <goals>
                            <goal>compile</goal>
                            <goal>testCompile</goal>
                        </goals>
                    </execution>
                </executions>
                <configuration>
                    <scalaVersion>${scala.version}</scalaVersion>
                    <args>
                        <arg>-Xmax-inlines</arg>
                        <arg>64</arg>
                        <arg>-no-indent</arg>
                        <arg>-deprecation</arg>
                        <arg>-feature</arg>
                        <arg>-unchecked</arg>
                        <arg>-Wunused:all</arg>
                        <arg>-Wvalue-discard</arg>
                        <arg>-Wnonunit-statement</arg>
                        <arg>-Werror</arg>
                        <arg>-Wconf:cat=unchecked:error</arg>
                        <arg>-Wconf:name=MatchCaseUnreachable:error</arg>
                        <arg>-Wconf:name=PatternMatchExhaustivity:error</arg>
                        <arg>-language:noAutoTupling</arg>
                        <arg>-source</arg>
                        <arg>3.8</arg>
                        <arg>-Xkind-projector</arg>
                    </args>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-antrun-plugin</artifactId>
                <executions>
                    <!-- Single owner of CEF archive download, SHA-1 verification, and extraction. -->
                    <execution>
                        <id>provision-cef</id>
                        <phase>process-classes</phase>
                        <goals>
                            <goal>run</goal>
                        </goals>
                        <configuration>
                            <target xmlns:if="ant:if" xmlns:unless="ant:unless">
                                <mkdir dir="${cef.dist.cache}"/>
                                <macrodef name="provision-cef">
                                    <attribute name="url"/>
                                    <attribute name="archive"/>
                                    <attribute name="distdir"/>
                                    <sequential>
                                        <local name="cef.expected.sha1"/>
                                        <local name="cef.actual.sha1"/>
                                        <local name="cef.sha.ok"/>
                                        <local name="cef.actual.sha1.2"/>
                                        <local name="cef.sha.ok2"/>
                                        <local name="cef.extracted"/>
                                        <local name="cef.complete.marker"/>
                                        <local name="cef.extract.tmp"/>
                                        <local name="cef.dist.name"/>
                                        <get src="@{url}.sha1" dest="@{archive}.sha1" skipexisting="true"/>
                                        <loadfile property="cef.expected.sha1" srcFile="@{archive}.sha1">
                                            <filterchain>
                                                <tokenfilter><deletecharacters chars="\r\n"/></tokenfilter>
                                            </filterchain>
                                        </loadfile>
                                        <get src="@{url}" dest="@{archive}" skipexisting="true"/>
                                        <checksum file="@{archive}" algorithm="SHA-1" property="cef.actual.sha1"/>
                                        <condition property="cef.sha.ok">
                                            <equals arg1="${cef.actual.sha1}" arg2="${cef.expected.sha1}"/>
                                        </condition>
                                        <get src="@{url}" dest="@{archive}" unless:set="cef.sha.ok"/>
                                        <checksum file="@{archive}" algorithm="SHA-1" property="cef.actual.sha1.2"/>
                                        <condition property="cef.sha.ok2">
                                            <equals arg1="${cef.actual.sha1.2}" arg2="${cef.expected.sha1}"/>
                                        </condition>
                                        <delete file="@{archive}" unless:set="cef.sha.ok2"/>
                                        <fail unless:set="cef.sha.ok2" message="CEF archive SHA-1 mismatch: @{archive}"/>
                                        <property name="cef.complete.marker" value="@{distdir}/.cef4j-complete-${cef.expected.sha1}"/>
                                        <condition property="cef.extracted">
                                            <and>
                                                <available file="${cef.complete.marker}"/>
                                                <available file="@{distdir}/include/cef_version.h"/>
                                                <available file="@{distdir}/Release" type="dir"/>
                                            </and>
                                        </condition>
                                        <sequential unless:set="cef.extracted">
                                            <tempfile property="cef.extract.tmp" destdir="${cef.dist.cache}" prefix=".cef-extract-"/>
                                            <mkdir dir="${cef.extract.tmp}"/>
                                            <untar src="@{archive}" dest="${cef.extract.tmp}" compression="bzip2"/>
                                            <basename property="cef.dist.name" file="@{distdir}"/>
                                            <fail message="Incomplete CEF extraction: @{archive}">
                                                <condition>
                                                    <not>
                                                        <and>
                                                            <available file="${cef.extract.tmp}/${cef.dist.name}/include/cef_version.h"/>
                                                            <available file="${cef.extract.tmp}/${cef.dist.name}/Release" type="dir"/>
                                                        </and>
                                                    </not>
                                                </condition>
                                            </fail>
                                            <touch file="${cef.extract.tmp}/${cef.dist.name}/.cef4j-complete-${cef.expected.sha1}"/>
                                            <java classname="net.kurobako.cef4j.codegen.CefCachePublisher"
                                                  fork="true" failonerror="true">
                                                <classpath refid="maven.runtime.classpath"/>
                                                <arg value="${cef.extract.tmp}/${cef.dist.name}"/>
                                                <arg value="@{distdir}"/>
                                                <arg value=".cef4j-complete-${cef.expected.sha1}"/>
                                            </java>
                                            <delete dir="${cef.extract.tmp}"/>
                                        </sequential>
                                    </sequential>
                                </macrodef>
                                <provision-cef url="${cef.dist.url}"
                                               archive="${cef.dist.cache}/cef_binary_${cef.version}_${cef.platform}_minimal.tar.bz2"
                                               distdir="${cef.dist.dir}"/>
                                <provision-cef url="${cef.codegen.linux.url}"
                                               archive="${cef.dist.cache}/cef_binary_${cef.version}_${cef.codegen.linux.platform}_minimal.tar.bz2"
                                               distdir="${cef.codegen.linux.dir}"/>
                                <provision-cef url="${cef.codegen.macos.url}"
                                               archive="${cef.dist.cache}/cef_binary_${cef.version}_${cef.codegen.macos.platform}_minimal.tar.bz2"
                                               distdir="${cef.codegen.macos.dir}"/>
                                <provision-cef url="${cef.codegen.windows.url}"
                                               archive="${cef.dist.cache}/cef_binary_${cef.version}_${cef.codegen.windows.platform}_minimal.tar.bz2"
                                               distdir="${cef.codegen.windows.dir}"/>
                            </target>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <finalName>cef4j-codegen-fat</finalName>
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                            <filters>
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <exclude>META-INF/MANIFEST.MF</exclude>
                                        <exclude>META-INF/versions/**/module-info.class</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                            <transformers>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ApacheLicenseResourceTransformer"/>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ApacheNoticeResourceTransformer"/>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <mainClass>net.kurobako.cef4j.codegen.Main</mainClass>
                                </transformer>
                            </transformers>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <argLine>@{jacoco.argLine} ${surefire.assertions} ${surefire.argLine} ${codegen.test.argLine}</argLine>
                    <includes>
                        <include>**/*Spec.*</include>
                        <include>**/*Test.*</include>
                        <include>**/*Suite.*</include>
                    </includes>
                    <excludes>
                        <exclude>**/*IntegrationSpec.*</exclude>
                        <exclude>**/*IT.*</exclude>
                    </excludes>
                </configuration>
            </plugin>
            <plugin>
                <groupId>com.diffplug.spotless</groupId>
                <artifactId>spotless-maven-plugin</artifactId>
                <configuration>
                    <scala>
                        <includes>
                            <include>src/**/*.scala</include>
                        </includes>
                        <scalafmt>
                            <version>3.9.8</version>
                            <file>${project.basedir}/.scalafmt.conf</file>
                            <scalaMajorVersion>2.13</scalaMajorVersion>
                        </scalafmt>
                    </scala>
                </configuration>
            </plugin>

            <!-- Integration tests (run against the CEF headers provisioned above) -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
                <configuration>
                    <argLine>@{jacoco.argLine} ${surefire.assertions} ${surefire.argLine} ${codegen.test.argLine}</argLine>
                    <includes>
                        <include>**/*IT.*</include>
                        <include>**/*IntegrationSpec.*</include>
                    </includes>
                    <systemPropertyVariables>
                        <cef.root>${cef.dist.dir}</cef.root>
                        <cef.compiler>${native.compiler.id}</cef.compiler>
                    </systemPropertyVariables>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>integration-test</goal>
                            <goal>verify</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <profile>
            <id>scala-unsafe-compatibility</id>
            <activation>
                <jdk>[24,)</jdk>
            </activation>
            <properties>
                <codegen.test.argLine>--sun-misc-unsafe-memory-access=allow</codegen.test.argLine>
            </properties>
        </profile>
    </profiles>
</project>
