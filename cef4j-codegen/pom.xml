<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>net.kurobako.cef4j</groupId>
        <artifactId>cef4j-parent</artifactId>
        <version>150.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>cef4j-codegen</artifactId>
    <name>cef4j-codegen</name>
    <description>Scala 3 code generator for CEF Java bindings</description>

    <properties>
        <!-- SpotBugs misfires on idiomatic Scala 3 bytecode (closures, inlined values, pattern-match
             lowerings). Not worth chasing; NullAway + Error Prone only run on Java, so this module is
             linted via Scala's own compiler warnings. -->
        <spotbugs.skip>true</spotbugs.skip>
        <!-- Scala 3.8 and the shaded code generator intentionally require Java 17. -->
        <bytecode.check.skip>true</bytecode.check.skip>
        <codegen.test.argLine/>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.scala-lang</groupId>
            <artifactId>scala3-library_3</artifactId>
        </dependency>
        <dependency>
            <groupId>org.typelevel</groupId>
            <artifactId>cats-core_3</artifactId>
        </dependency>
        <dependency>
            <groupId>net.kurobako.cef4j</groupId>
            <artifactId>cef4j-cef-dist</artifactId>
            <type>pom</type>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>net.kurobako.cef4j</groupId>
            <artifactId>cef4j-code-policy</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>com.lihaoyi</groupId>
            <artifactId>ujson_3</artifactId>
        </dependency>
        <dependency>
            <groupId>org.apache.commons</groupId>
            <artifactId>commons-compress</artifactId>
        </dependency>
        <dependency>
            <groupId>org.scalameta</groupId>
            <artifactId>munit_3</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <sourceDirectory>src/main/scala</sourceDirectory>
        <testSourceDirectory>src/test/scala</testSourceDirectory>
        <plugins>
            <plugin>
                <groupId>net.alchim31.maven</groupId>
                <artifactId>scala-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <goals>
                            <goal>compile</goal>
                            <goal>testCompile</goal>
                        </goals>
                    </execution>
                </executions>
                <configuration>
                    <scalaVersion>${scala.version}</scalaVersion>
                    <args>
                        <arg>-Xmax-inlines</arg>
                        <arg>64</arg>
                        <arg>-no-indent</arg>
                        <arg>-deprecation</arg>
                        <arg>-feature</arg>
                        <arg>-unchecked</arg>
                        <arg>-Wunused:all</arg>
                        <arg>-Wvalue-discard</arg>
                        <arg>-Wnonunit-statement</arg>
                        <arg>-Werror</arg>
                        <arg>-Wconf:cat=unchecked:error</arg>
                        <arg>-Wconf:name=MatchCaseUnreachable:error</arg>
                        <arg>-Wconf:name=PatternMatchExhaustivity:error</arg>
                        <arg>-language:noAutoTupling</arg>
                        <arg>-source</arg>
                        <arg>3.8</arg>
                        <arg>-Xkind-projector</arg>
                    </args>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <finalName>cef4j-codegen-fat</finalName>
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                            <filters>
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <exclude>META-INF/MANIFEST.MF</exclude>
                                        <exclude>META-INF/versions/**/module-info.class</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                            <transformers>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ApacheLicenseResourceTransformer"/>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ApacheNoticeResourceTransformer"/>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <mainClass>net.kurobako.cef4j.codegen.Main</mainClass>
                                </transformer>
                            </transformers>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <argLine>@{jacoco.argLine} ${surefire.argLine} ${codegen.test.argLine}</argLine>
                    <includes>
                        <include>**/*Spec.*</include>
                        <include>**/*Test.*</include>
                        <include>**/*Suite.*</include>
                    </includes>
                    <excludes>
                        <exclude>**/*IntegrationSpec.*</exclude>
                        <exclude>**/*IT.*</exclude>
                    </excludes>
                </configuration>
            </plugin>
            <plugin>
                <groupId>com.diffplug.spotless</groupId>
                <artifactId>spotless-maven-plugin</artifactId>
                <configuration>
                    <scala>
                        <includes>
                            <include>src/**/*.scala</include>
                        </includes>
                        <scalafmt>
                            <version>3.9.8</version>
                            <file>${project.basedir}/.scalafmt.conf</file>
                            <scalaMajorVersion>2.13</scalaMajorVersion>
                        </scalafmt>
                    </scala>
                </configuration>
            </plugin>

            <!-- Integration tests (run against real CEF headers, provisioned by cef4j-cef-dist) -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
                <configuration>
                    <argLine>@{jacoco.argLine} ${surefire.argLine} ${codegen.test.argLine}</argLine>
                    <includes>
                        <include>**/*IT.*</include>
                        <include>**/*IntegrationSpec.*</include>
                    </includes>
                    <systemPropertyVariables>
                        <cef.root>${cef.dist.dir}</cef.root>
                        <cef.compiler>${native.compiler.id}</cef.compiler>
                    </systemPropertyVariables>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>integration-test</goal>
                            <goal>verify</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <profile>
            <id>scala-unsafe-compatibility</id>
            <activation>
                <jdk>[24,)</jdk>
            </activation>
            <properties>
                <codegen.test.argLine>--sun-misc-unsafe-memory-access=allow</codegen.test.argLine>
            </properties>
        </profile>
    </profiles>
</project>
