{
  "version": {"major": "1", "minor": "3"},
  "domains": [
    {
      "domain": "Page",
      "description": "A small `Page` fixture.",
      "types": [
        {"id": "FrameId", "type": "string"},
        {"id": "Frame", "type": "object", "properties": [{"name": "id", "$ref": "FrameId"}]}
      ],
      "commands": [
        {
          "name": "navigate",
          "parameters": [{"name": "url", "type": "string"}],
          "returns": [{"name": "frameId", "$ref": "FrameId"}]
        }
      ],
      "events": [{"name": "loadEventFired", "deprecated": true, "parameters": [{"name": "time", "type": "number"}]}]
    }
  ]
}
