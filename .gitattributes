# Normalize all text files to LF on commit and checkout.
# This prevents CRLF-contaminated string literals in Scala source from
# bleeding into generated C++ / Java output.
* text=auto eol=lf

# Explicit text types
*.java    text eol=lf
*.scala   text eol=lf
*.cpp     text eol=lf
*.h       text eol=lf
*.mm      text eol=lf
*.xml     text eol=lf
*.md      text eol=lf
*.txt     text eol=lf
*.map     text eol=lf
*.json    text eol=lf
*.properties text eol=lf
*.yml     text eol=lf
*.yaml    text eol=lf
*.sh      text eol=lf
Makefile  text eol=lf
mvnw      text eol=lf

# Windows scripts must keep CRLF
*.bat     text eol=crlf
*.cmd     text eol=crlf
mvnw.cmd  text eol=crlf

# Binary — never touch line endings
*.jar     binary
*.dll     binary
*.so      binary
*.dylib   binary
*.exe     binary
*.lib     binary
*.a       binary
*.png     binary
*.ico     binary
*.bz2     binary
*.gz      binary
*.zip     binary
*.pak     binary
*.bin     binary
