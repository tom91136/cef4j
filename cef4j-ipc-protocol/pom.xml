<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>net.kurobako.cef4j</groupId>
        <artifactId>cef4j-parent</artifactId>
        <version>146.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>cef4j-ipc-protocol</artifactId>
    <packaging>jar</packaging>
    <name>cef4j-ipc-protocol</name>
    <description>Codegen-emitted wire-format messages for the cef4j IPC backend</description>

    <properties>
        <exec.skip>false</exec.skip>
        <ipc.gen.package>net.kurobako.cef4j.ipc.protocol.gen</ipc.gen.package>
        <ipc.gen.dir>${project.basedir}/src/main/java</ipc.gen.dir>
    </properties>

    <dependencies>
        <dependency>
            <groupId>net.kurobako.cef4j</groupId>
            <artifactId>cef4j-ipc-session</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.google.code.findbugs</groupId>
            <artifactId>jsr305</artifactId>
        </dependency>

        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-simple</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Pulls jeromq onto the test classpath so StubHelperMain (test-scope main class spawned as a
             subprocess) can bind a ZMQ socket. -->
        <dependency>
            <groupId>org.zeromq</groupId>
            <artifactId>jeromq</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Build-order edge: forces the C++ helper binary to be produced before our integration test runs.
             Tests gate on the binary existing and skip gracefully if absent. -->
        <dependency>
            <groupId>net.kurobako.cef4j</groupId>
            <artifactId>cef4j-ipc-helper-native</artifactId>
            <version>${project.version}</version>
            <type>pom</type>
            <scope>test</scope>
            <optional>true</optional>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- IPC codegen needs the CEF headers; share the same dist cache as cef4j-native. Runs at
                 `initialize` so the headers exist by the time exec-maven-plugin runs `Main` at `generate-sources`. -->
            <plugin>
                <groupId>com.googlecode.maven-download-plugin</groupId>
                <artifactId>download-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>download-cef-for-ipc-codegen</id>
                        <phase>initialize</phase>
                        <goals><goal>wget</goal></goals>
                        <configuration>
                            <url>${cef.dist.url}</url>
                            <outputDirectory>${cef.dist.cache}</outputDirectory>
                            <unpackWhenChanged>true</unpackWhenChanged>
                            <skipCache>false</skipCache>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>run-ipc-codegen</id>
                        <phase>generate-sources</phase>
                        <goals><goal>java</goal></goals>
                        <configuration>
                            <includePluginDependencies>true</includePluginDependencies>
                            <mainClass>net.kurobako.cef4j.codegen.ipc.Main</mainClass>
                            <arguments>
                                <argument>--out-java=${ipc.gen.dir}</argument>
                                <argument>--java-package=${ipc.gen.package}</argument>
                                <argument>--cef-include=${cef.dist.dir}/include</argument>
                                <argument>--compiler=${native.compiler.id}</argument>
                                <argument>--cef-api-version=${cef.version}</argument>
                            </arguments>
                        </configuration>
                    </execution>
                </executions>
                <dependencies>
                    <dependency>
                        <groupId>net.kurobako.cef4j</groupId>
                        <artifactId>cef4j-codegen</artifactId>
                        <version>${project.version}</version>
                    </dependency>
                </dependencies>
            </plugin>
            <plugin>
                <groupId>com.diffplug.spotless</groupId>
                <artifactId>spotless-maven-plugin</artifactId>
                <configuration>
                    <java>
                        <excludes>
                            <exclude>src/main/java/net/kurobako/cef4j/ipc/protocol/gen/**/*.java</exclude>
                        </excludes>
                    </java>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <systemPropertyVariables>
                        <cef4j.ipc.helper.binary>${maven.multiModuleProjectDirectory}/cef4j-ipc-helper-native/target/cmake-build/cef4j-helper</cef4j.ipc.helper.binary>
                        <cef4j.ipc.cef.resources>${cef.dist.dir}/Release</cef4j.ipc.cef.resources>
                    </systemPropertyVariables>
                    <!-- JeroMQ 0.6.0 can corrupt its Ctx mailbox table when many independently-created
                         ZContext instances are torn down in one JVM. Most protocol integration classes
                         create at least one real helper/transport pair, so isolate classes just as the
                         frame-mmap integration module does. -->
                    <reuseForks>false</reuseForks>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
