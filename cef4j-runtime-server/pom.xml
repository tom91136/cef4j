<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>net.kurobako.cef4j</groupId>
        <artifactId>cef4j-parent</artifactId>
        <version>150.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>cef4j-runtime-server</artifactId>
    <packaging>pom</packaging>
    <name>cef4j-runtime-server</name>
    <description>Thin native runtime server exposing the Remote CEF API</description>

    <properties>

        <japicmp.skip>true</japicmp.skip>
        <ipc.gen.cpp.dir>${project.basedir}/src/main/cpp/gen</ipc.gen.cpp.dir>
    </properties>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-antrun-plugin</artifactId>
                <executions>
                    <execution>
                        <id>mkdir-cmake-build</id>
                        <phase>initialize</phase>
                        <goals><goal>run</goal></goals>
                        <configuration>
                            <target>
                                <mkdir dir="${project.build.directory}/cmake-build"/>
                            </target>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>run-ipc-codegen-cpp</id>
                        <phase>generate-sources</phase>
                        <goals><goal>java</goal></goals>
                        <configuration>
                            <includePluginDependencies>true</includePluginDependencies>
                            <mainClass>net.kurobako.cef4j.codegen.ipc.Main</mainClass>
                            <arguments>
                                <argument>--out-cpp=${ipc.gen.cpp.dir}</argument>
                                <argument>--cef-include=${cef.dist.dir}/include</argument>
                                <argument>--compiler=${native.compiler.id}</argument>
                                <argument>--cef-api-version=${cef.version}</argument>
                            </arguments>
                        </configuration>
                    </execution>
                    <execution>
                        <id>cmake-configure</id>
                        <phase>compile</phase>
                        <goals><goal>exec</goal></goals>
                        <configuration>
                            <executable>cmake</executable>
                            <workingDirectory>${project.build.directory}/cmake-build</workingDirectory>
                            <arguments>
                                <argument>${project.basedir}</argument>
                                <argument>-G${cmake.generator}</argument>
                                <argument>-DCMAKE_TOOLCHAIN_FILE=${cmake.toolchain.file}</argument>
                                <argument>-DCEF_ROOT=${cef.dist.dir}</argument>
                                <argument>-DCEF4J_API_VERSION_RAW=${cef.version}</argument>
                                <argument>-DCEF4J_ENABLE_TEST_SANITIZERS=${native.test.sanitizers}</argument>
                                <argument>-DCMAKE_BUILD_TYPE=Release</argument>
                                <argument>-Wno-deprecated</argument>
                            </arguments>
                        </configuration>
                    </execution>
                    <execution>
                        <id>cmake-build</id>
                        <phase>compile</phase>
                        <goals><goal>exec</goal></goals>
                        <configuration>
                            <executable>cmake</executable>
                            <arguments>
                                <argument>--build</argument>
                                <argument>${project.build.directory}/cmake-build</argument>
                                <argument>--config</argument>
                                <argument>Release</argument>
                            </arguments>
                        </configuration>
                    </execution>
                    <execution>
                        <id>native-tests</id>
                        <phase>test</phase>
                        <goals><goal>exec</goal></goals>
                        <configuration>
                            <executable>ctest</executable>
                            <arguments>
                                <argument>--test-dir</argument>
                                <argument>${project.build.directory}/cmake-build</argument>
                                <argument>--output-on-failure</argument>
                            </arguments>
                        </configuration>
                    </execution>
                </executions>
                <dependencies>
                    <dependency>
                        <groupId>net.kurobako.cef4j</groupId>
                        <artifactId>cef4j-codegen</artifactId>
                        <version>${project.version}</version>
                    </dependency>
                </dependencies>
            </plugin>
            <plugin>
                <groupId>com.diffplug.spotless</groupId>
                <artifactId>spotless-maven-plugin</artifactId>
                <configuration>
                    <skip>${clang.format.skip}</skip>
                    <cpp>
                        <includes>
                            <include>src/main/cpp/**/*.cpp</include>
                            <include>src/main/cpp/**/*.h</include>
                            <include>src/main/macos/**/*.mm</include>
                            <include>src/test/cpp/**/*.cpp</include>
                            <include>src/test/cpp/**/*.h</include>
                        </includes>
                        <replaceRegex>
                            <name>unprefixed fixed-width integers</name>
                            <searchRegex>\bstd::(u?int(?:_least|_fast)?(?:8|16|32|64)_t|u?intptr_t|u?intmax_t|size_t|ptrdiff_t)\b</searchRegex>
                            <replacement>$1</replacement>
                        </replaceRegex>
                        <clangFormat>
                            <version>${clang.format.version}</version>
                            <pathToExe>${clang.format.exe}</pathToExe>
                            <style>file:${maven.multiModuleProjectDirectory}/.clang-format</style>
                        </clangFormat>
                    </cpp>
                </configuration>
                <executions>
                    <execution>
                        <id>format-generated-sources</id>
                        <phase>generate-sources</phase>
                        <goals>
                            <goal>apply</goal>
                        </goals>
                        <configuration>
                            <filePatterns>.*[/\\]gen[/\\].*</filePatterns>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <profile>
            <id>release-runtime-server-bundle</id>
            <activation>
                <property>
                    <name>release.bundle</name>
                    <value>true</value>
                </property>
            </activation>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-assembly-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>assemble-runtime-server</id>
                                <phase>package</phase>
                                <goals><goal>single</goal></goals>
                                <configuration>
                                    <descriptors>
                                        <descriptor>src/assembly/runtime-server.xml</descriptor>
                                    </descriptors>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>

    <dependencies>
    </dependencies>
</project>
