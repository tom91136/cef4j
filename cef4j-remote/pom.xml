<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>net.kurobako.cef4j</groupId>
        <artifactId>cef4j-parent</artifactId>
        <version>150.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>cef4j-remote</artifactId>
    <name>cef4j-remote</name>
    <description>Remote CEF transports, sessions, runtime-server lifecycle, generated API, DevTools, and WebDriver adapter</description>

    <properties>
        <ipc.gen.package>net.kurobako.cef4j.ipc.protocol.gen</ipc.gen.package>
        <ipc.gen.dir>${project.basedir}/src/main/java</ipc.gen.dir>
        <java11.runtime.smoke.skip>false</java11.runtime.smoke.skip>
    </properties>

    <dependencies>
        <dependency>
            <groupId>net.kurobako.cef4j</groupId>
            <artifactId>cef4j-cdp</artifactId>
        </dependency>
        <dependency>
            <groupId>net.kurobako.cef4j</groupId>
            <artifactId>cef4j-webdriver</artifactId>
        </dependency>
        <dependency>
            <groupId>org.zeromq</groupId>
            <artifactId>jeromq</artifactId>
        </dependency>
        <dependency>
            <groupId>com.kohlschutter.junixsocket</groupId>
            <artifactId>junixsocket-core</artifactId>
            <type>pom</type>
            <!-- Java 11 has no standard Unix-domain socket API. Keep this explicit UDS optimization available to
                 cef4j itself without forcing native socket artifacts on portable transport consumers. -->
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>com.google.code.findbugs</groupId>
            <artifactId>jsr305</artifactId>
        </dependency>
        <dependency>
            <groupId>net.kurobako.cef4j</groupId>
            <artifactId>cef4j-code-policy</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
        </dependency>

        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-simple</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>net.kurobako.cef4j</groupId>
            <artifactId>cef4j-test-support</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <resources>
            <resource>
                <directory>src/main/resources</directory>
                <filtering>true</filtering>
                <includes>
                    <include>**/version.properties</include>
                </includes>
            </resource>
            <resource>
                <directory>src/main/resources</directory>
                <excludes>
                    <exclude>**/version.properties</exclude>
                </excludes>
            </resource>
        </resources>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-resources-plugin</artifactId>
                <configuration>
                    <propertiesEncoding>UTF-8</propertiesEncoding>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <!-- junixsocket carries CLASS-retained references to unpublished build annotations. -->
                <configuration>
                    <compilerArgs combine.children="append"><arg>-Xlint:-classfile</arg></compilerArgs>
                </configuration>
            </plugin>
            <!-- IPC codegen reads the CEF headers that cef4j-codegen provisions. -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>run-ipc-codegen</id>
                        <phase>generate-sources</phase>
                        <goals><goal>java</goal></goals>
                        <configuration>
                            <includePluginDependencies>true</includePluginDependencies>
                            <mainClass>net.kurobako.cef4j.codegen.ipc.Main</mainClass>
                            <arguments>
                                <argument>--out-java=${ipc.gen.dir}</argument>
                                <argument>--java-package=${ipc.gen.package}</argument>
                                <argument>--cef-include=${cef.dist.dir}/include</argument>
                                <argument>--compiler=${native.compiler.id}</argument>
                                <argument>--cef-api-version=${cef.version}</argument>
                            </arguments>
                        </configuration>
                    </execution>
                </executions>
                <dependencies>
                    <dependency>
                        <groupId>net.kurobako.cef4j</groupId>
                        <artifactId>cef4j-codegen</artifactId>
                        <version>${project.version}</version>
                    </dependency>
                </dependencies>
            </plugin>
            <plugin>
                <groupId>com.diffplug.spotless</groupId>
                <artifactId>spotless-maven-plugin</artifactId>
                <configuration>
                    <java>
                        <excludes>
                            <exclude>src/main/java/net/kurobako/cef4j/ipc/protocol/gen/**/*.java</exclude>
                        </excludes>
                    </java>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!-- Transport and session tests never load CEF. -->
        <profile>
            <id>skip-cef-independent-tests</id>
            <activation>
                <property>
                    <name>cef4j.cefIndependentTests.skip</name>
                    <value>true</value>
                </property>
            </activation>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-surefire-plugin</artifactId>
                        <configuration>
                            <excludes combine.children="append">
                                <exclude>net/kurobako/cef4j/ipc/session/**</exclude>
                                <exclude>net/kurobako/cef4j/ipc/transport/**</exclude>
                            </excludes>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
