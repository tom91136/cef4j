<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>net.kurobako.cef4j</groupId>
        <artifactId>cef4j-parent</artifactId>
        <version>146.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>cef4j-integration-tests</artifactId>
    <packaging>jar</packaging>
    <name>cef4j-integration-tests</name>
    <description>Cross-backend scenarios against the in-process backend and packaged CEF runtime server</description>

    <properties>
        <!-- This module needs JFX at test time for NativeBrowserBackend (its session opens a JFX Stage).
             Use 13.0.2 throughout to avoid the JFX-graphics:11 + JFX-base:13.0.2 mix that tripped a SIGSEGV
             in glassgtk3 staticScreen_getScreens (the transitive dep from cef4j-inprocess-jfx forces base to 13.0.2,
             so graphics must match). -->
        <javafx.version>13.0.2</javafx.version>
        <javafx.test.version>13.0.2</javafx.test.version>
    </properties>

    <dependencies>
        <!-- The SPI itself. -->
        <dependency>
            <groupId>net.kurobako.cef4j</groupId>
            <artifactId>cef4j-test-shared</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>

        <!-- Remote CEF client layers exercised by the packaged-runtime suites. -->
        <dependency>
            <groupId>net.kurobako.cef4j</groupId>
            <artifactId>cef4j-remote-core</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>net.kurobako.cef4j</groupId>
            <artifactId>cef4j-remote-frame</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>net.kurobako.cef4j</groupId>
            <artifactId>cef4j-remote-jfx</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>net.kurobako.cef4j</groupId>
            <artifactId>cef4j-remote-swing</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>net.kurobako.cef4j</groupId>
            <artifactId>cef4j-remote-api</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>net.kurobako.cef4j</groupId>
            <artifactId>cef4j-remote-recording-jackson</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>net.kurobako.cef4j</groupId>
            <artifactId>cef4j-remote-cdp-gson</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>net.kurobako.cef4j</groupId>
            <artifactId>cef4j-webdriver</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>net.kurobako.cef4j</groupId>
            <artifactId>cef4j-webdriver-gson</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>net.kurobako.cef4j</groupId>
            <artifactId>cef4j-remote-webdriver</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>net.kurobako.cef4j</groupId>
            <artifactId>cef4j-inprocess-webdriver</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>net.kurobako.cef4j</groupId>
            <artifactId>cef4j-runtime-server</artifactId>
            <version>${project.version}</version>
            <type>pom</type>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.kohlschutter.junixsocket</groupId>
            <artifactId>junixsocket-core</artifactId>
            <version>${junixsocket.version}</version>
            <type>pom</type>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>net.kurobako.cef4j</groupId>
            <artifactId>cef4j-inprocess-jfx</artifactId>
            <version>${project.version}</version>
            <type>test-jar</type>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>net.kurobako.cef4j</groupId>
            <artifactId>cef4j-inprocess-jfx</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <!-- libcef.so / Chromium runtime files for the native backend. Same classifier-based selection as
             cef4j-inprocess-jfx; the classifier is set per-platform by profiles in the parent pom. -->
        <dependency>
            <groupId>net.kurobako.cef4j</groupId>
            <artifactId>cef4j-platform</artifactId>
            <version>${project.version}</version>
            <classifier>${cef.classifier}</classifier>
            <scope>test</scope>
        </dependency>

        <!-- Transitive runtime needs: each backend's session pulls in its own runtime deps, but we still
             need test-scoped JUnit/AssertJ for the matrix tests themselves. -->
        <!-- JavaFX runtime for the native backend's Stage. Keep graphics and controls aligned with the
             cef4j-inprocess-jfx test runtime to avoid mixing incompatible JavaFX versions. -->
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-graphics</artifactId>
            <version>${javafx.test.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-controls</artifactId>
            <version>${javafx.test.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.seleniumhq.selenium</groupId>
            <artifactId>selenium-java</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-simple</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-antrun-plugin</artifactId>
                <executions>
                    <execution>
                        <id>bucket-v8-value-tests</id>
                        <phase>initialize</phase>
                        <goals><goal>run</goal></goals>
                        <configuration>
                            <exportAntProperties>true</exportAntProperties>
                            <target>
                                <condition property="cef4j.test.v8value.excludes"
                                           value="__never__"
                                           else="**/CodegenV8DispatchTest.java">
                                    <matches string="${cef.version}"
                                             pattern="^(14[4-9]|1[5-9][0-9]|[2-9][0-9]{2,})\..*"/>
                                </condition>
                            </target>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <release>11</release>
                    <testExcludes>
                        <testExclude>${cef4j.test.v8value.excludes}</testExclude>
                    </testExcludes>
                    <testIncrementalExcludes>
                        <testIncrementalExclude>${cef4j.test.v8value.excludes}</testIncrementalExclude>
                    </testIncrementalExcludes>
                </configuration>
            </plugin>
            <plugin>
                <groupId>com.diffplug.spotless</groupId>
                <artifactId>spotless-maven-plugin</artifactId>
            </plugin>
            <plugin>
                <!-- Some matrix tests initialise in-process CEF, whose process-global lifecycle cannot be restarted
                     safely between classes. System properties mirror cef4j-inprocess-jfx: JFX needs headless=false
                     (surefire default would crash glassgtk3 in XInternAtom) and the native backend needs
                     cef4j.libcef.dir to find libcef.so. -->
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <systemPropertyVariables>
                        <cef4j.libcef.dir>${cef.dist.dir}/Release</cef4j.libcef.dir>
                        <cef4j.disableStderrRedirect>true</cef4j.disableStderrRedirect>
                        <java.awt.headless>false</java.awt.headless>
                        <cef4j.runtime.server.binary>${maven.multiModuleProjectDirectory}/cef4j-runtime-server/target/cmake-build/runtime-server/${runtime.server.executable}</cef4j.runtime.server.binary>
                        <cef4j.runtime.server.resources>${maven.multiModuleProjectDirectory}/cef4j-runtime-server/target/cmake-build/runtime-server</cef4j.runtime.server.resources>
                    </systemPropertyVariables>
                    <reuseForks>false</reuseForks>
                </configuration>
            </plugin>
        </plugins>
    </build>
    <profiles>
        <profile>
            <id>linux-aarch64-static-tls</id>
            <activation>
                <os><name>Linux</name><arch>aarch64</arch></os>
            </activation>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-surefire-plugin</artifactId>
                        <configuration combine.self="merge">
                            <environmentVariables>
                                <LD_PRELOAD>${cef.dist.dir}/Release/libcef.so</LD_PRELOAD>
                            </environmentVariables>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
