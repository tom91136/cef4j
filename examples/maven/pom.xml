<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <groupId>net.kurobako.cef4j.examples</groupId>
    <artifactId>cef4j-maven-consumer</artifactId>
    <version>1.0.0-SNAPSHOT</version>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.release>11</maven.compiler.release>
        <cef4j.version>150.0.0</cef4j.version>
        <cef4j.packager.version>0.1.0</cef4j.packager.version>
        <cef4j.platform.artifact>cef4j-platform-linux</cef4j.platform.artifact>
        <cef4j.platform.classifier>x86_64</cef4j.platform.classifier>
        <cef.version>150.0.18+gdb11278+chromium-150.0.7871.213</cef.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>net.kurobako.cef4j</groupId>
            <artifactId>cef4j-inprocess-swing</artifactId>
            <version>${cef4j.version}</version>
        </dependency>
        <dependency>
            <groupId>net.kurobako.cef4j</groupId>
            <artifactId>cef4j-cdp</artifactId>
            <version>${cef4j.version}</version>
        </dependency>
        <dependency>
            <groupId>net.kurobako.cef4j</groupId>
            <artifactId>${cef4j.platform.artifact}</artifactId>
            <version>${cef4j.version}</version>
            <classifier>${cef4j.platform.classifier}</classifier>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.6.3</version>
                <executions>
                    <execution>
                        <id>package-cef-runtime</id>
                        <phase>generate-resources</phase>
                        <goals><goal>java</goal></goals>
                        <configuration>
                            <includeProjectDependencies>false</includeProjectDependencies>
                            <includePluginDependencies>true</includePluginDependencies>
                            <mainClass>net.kurobako.cef4j.packager.CefPackager</mainClass>
                            <arguments>
                                <argument>package</argument>
                                <argument>--cef-version=${cef.version}</argument>
                                <argument>--platform=linux-x86_64</argument>
                                <argument>--locales=en-US</argument>
                                <argument>--output=${project.build.outputDirectory}</argument>
                            </arguments>
                        </configuration>
                    </execution>
                    <execution>
                        <id>run-example</id>
                        <phase>verify</phase>
                        <goals><goal>java</goal></goals>
                        <configuration>
                            <includeProjectDependencies>true</includeProjectDependencies>
                            <includePluginDependencies>false</includePluginDependencies>
                            <mainClass>example.Main</mainClass>
                        </configuration>
                    </execution>
                </executions>
                <dependencies>
                    <dependency>
                        <groupId>net.kurobako.cef4j</groupId>
                        <artifactId>cef4j-runtime-packager</artifactId>
                        <version>${cef4j.packager.version}</version>
                    </dependency>
                </dependencies>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.15.0</version>
            </plugin>
        </plugins>
    </build>
</project>
